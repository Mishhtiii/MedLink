<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/register.css" rel="stylesheet" />
    <style>
      /* Wizard Step Transitions mapping code */
      .form-step {
        display: none;
        animation: formFadeSlideIn 0.4s ease-in-out;
      }
      .form-step.active {
        display: block;
      }
      @keyframes formFadeSlideIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Medical Practitioner Enrollment</div>
          <h1 class="hero-title text-white">
            Join MedLink Network <br />
            & Expand Your <br />
            Clinical Practice
          </h1>
          <p class="hero-text">
            Register as a certified health expert onto our integrated servers. 
            Connect seamlessly with incoming patient diagnostics streams, schedule token sessions, and coordinate care workflows digitally.
          </p>
        </div>
      </div>
    </section>

    <section class="auth-form-section py-5">
      <div
        class="container bg-white shadow-sm border rounded-5 p-4 p-md-5"
        style="
          margin-top: -40px;
          position: relative;
          z-index: 10;
          max-width: 650px;
        "
      >
        <div class="form-container">
          <div class="about-badge mb-3">
            <span class="dot-teal me-2"></span> Practitioner Enrollment
          </div>
          <h2 class="form-main-title mb-2">Create Doctor Account</h2>
          <p class="text-muted small mb-4">
            Please fill in your authentic medical parameters to configure your specialist portal file node.
          </p>

          <form
            action="/doctorRegister"
            method="POST"
            enctype="multipart/form-data"
            id="multiStepForm"
            class="contact-form d-flex flex-column gap-2"
          >
            <% if (req.query.error === "UsernameTaken") { %>
              <div class="error-message p-3 mb-2 rounded-3 text-center small bg-danger text-white fw-bold">
                <i class="fas fa-circle-exclamation me-2"></i> Username is already taken.
              </div>
            <% } else if (req.query.error === "Length") { %>
              <div class="error-message p-3 mb-2 rounded-3 text-center small bg-danger text-white fw-bold">
                <i class="fas fa-key me-2"></i> Password must be at least 8 characters.
              </div>
            <% } else if (req.query.error === "MissingFields") { %>
              <div class="error-message p-3 mb-2 rounded-3 text-center small bg-danger text-white fw-bold">
                <i class="fas fa-triangle-exclamation me-2"></i> Please fill in all fields.
              </div>
            <% } %>

            <div class="step-wizard-indicator mb-3 p-2 bg-light rounded-3 d-flex justify-content-between align-items-center">
              <span class="small text-muted fw-medium">Steps:</span>
              <span class="badge bg-teal-accent text-white px-3 py-2 rounded-pill" style="font-size: 12px; background-color: #00a8bd;">
                Step <span id="step-count">1</span> of 4
              </span>
            </div>

            <div class="form-step active" id="step1">
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Full Name</label>
                <div class="position-relative">
                  <i class="fas fa-user-md input-inside-icon"></i>
                  <input type="text" name="name" class="form-input-control" placeholder="Full Name" required />
                </div>
              </div>
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Username Profile ID</label>
                <div class="position-relative">
                  <i class="fas fa-id-badge input-inside-icon"></i>
                  <input type="text" name="username" class="form-input-control" placeholder="Username" required />
                </div>
              </div>
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Email Address</label>
                <div class="position-relative">
                  <i class="fas fa-envelope input-inside-icon"></i>
                  <input type="email" name="email" class="form-input-control" placeholder="Email" required />
                </div>
              </div>
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Password Security ID</label>
                <div class="position-relative">
                  <i class="fas fa-lock input-inside-icon"></i>
                  <input type="password" name="password" class="form-input-control" placeholder="Password" required />
                </div>
              </div>
              <div class="form-group-custom position-relative mb-4">
                <label class="form-label-text">Contact Phone</label>
                <div class="position-relative">
                  <i class="fas fa-phone input-inside-icon"></i>
                  <input type="tel" name="phone" class="form-input-control" placeholder="Phone" required />
                </div>
              </div>
              
              <button type="button" class="btn-submit-action w-100" onclick="nextStep(1)">
                Next Step <i class="fas fa-chevron-right ms-2"></i>
              </button>
            </div>

            <div class="form-step" id="step2">
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Select Domain Speciality</label>
                <div class="position-relative">
                  <i class="fas fa-stethoscope input-inside-icon"></i>
                  <select name="specialization" class="form-input-control select-arrow-pad" required>
                    <option value="">Select Speciality</option>
                    <option value="General practitioner">General practitioner</option>
                    <option value="Dentistry">Dentistry</option>
                    <option value="Neurology">Neurology</option>
                    <option value="Dermatology">Dermatology</option>
                    <option value="X-Ray">X-Ray</option>
                    <option value="Urology">Urology</option>
                    <option value="Psychiatry">Psychiatry</option>
                  </select>
                </div>
              </div>
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Qualification Credentials</label>
                <div class="position-relative">
                  <i class="fas fa-graduation-cap input-inside-icon"></i>
                  <input type="text" name="qualification" class="form-input-control" placeholder="Qualification (e.g. MBBS)" required />
                </div>
              </div>
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Practice Experience</label>
                <div class="position-relative">
                  <i class="fas fa-business-time input-inside-icon"></i>
                  <input type="text" name="experience" class="form-input-control" placeholder="Experience (e.g. 5 years)" required />
                </div>
              </div>
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Clinic / Hospital Attachment</label>
                <div class="position-relative">
                  <i class="fas fa-hospital input-inside-icon"></i>
                  <input type="text" name="hospital" class="form-input-control" placeholder="Hospital Name" required />
                </div>
              </div>
              <div class="form-group-custom position-relative mb-4">
                <label class="form-label-text">Operational City Location</label>
                <div class="position-relative">
                  <i class="fas fa-map-location-dot input-inside-icon"></i>
                  <input type="text" name="location" class="form-input-control" placeholder="City" required />
                </div>
              </div>

              <div class="d-flex gap-3">
                <button type="button" class="btn-submit-action btn-back-muted w-50" onclick="prevStep(2)">
                  <i class="fas fa-chevron-left me-2"></i> Back
                </button>
                <button type="button" class="btn-submit-action w-50" onclick="nextStep(2)">
                  Next <i class="fas fa-chevron-right ms-2"></i>
                </button>
              </div>
            </div>

            <div class="form-step" id="step3">
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Consultation Fees (INR)</label>
                <div class="position-relative">
                  <i class="fas fa-indian-rupee-sign input-inside-icon"></i>
                  <input type="number" name="fees" class="form-input-control" placeholder="Fees (₹)" required />
                </div>
              </div>
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Daily Operation Availability Shift</label>
                <div class="position-relative">
                  <i class="fas fa-clock-rotate-left input-inside-icon"></i>
                  <select name="availability" class="form-input-control select-arrow-pad" required>
                    <option value="">Select Availability</option>
                    <option value="Morning">Morning</option>
                    <option value="Afternoon">Afternoon</option>
                    <option value="Evening">Evening</option>
                    <option value="Full Day">Full Day</option>
                  </select>
                </div>
              </div>
              <div class="form-group-custom position-relative mb-4">
                <label class="form-label-text bg-light p-2 rounded d-block border small text-secondary">
                  <i class="fas fa-image me-1"></i> Upload Professional Profile Image
                </label>
                <input type="file" name="image" class="form-control p-2 mt-1 border-2" style="border-radius:10px;" required />
              </div>

              <div class="d-flex gap-3">
                <button type="button" class="btn-submit-action btn-back-muted w-50" onclick="prevStep(3)">
                  <i class="fas fa-chevron-left me-2"></i> Back
                </button>
                <button type="button" class="btn-submit-action w-50" onclick="nextStep(3)">
                  Next <i class="fas fa-chevron-right ms-2"></i>
                </button>
              </div>
            </div>

            <div class="form-step" id="step4">
              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text">Aadhar Card Number</label>
                <div class="position-relative">
                  <i class="fas fa-id-card input-inside-icon"></i>
                  <input type="text" name="aadharNumber" class="form-input-control" placeholder="12-Digit Aadhar Card Number" pattern="[0-max]{12}" minlength="12" maxlength="12" required />
                </div>
              </div>

              <div class="form-group-custom position-relative mb-3">
                <label class="form-label-text bg-light p-2 rounded d-block border small text-secondary">
                  <i class="fas fa-certificate me-1"></i> Upload Medical License Proof File
                </label>
                <input type="file" name="license" class="form-control p-2 mt-1 border-2" style="border-radius:10px;" required />
              </div>

              <div class="form-group-custom position-relative mb-4">
                <label class="form-label-text bg-light p-2 rounded d-block border small text-secondary">
                  <i class="fas fa-user-graduate me-1"></i> Upload Degree Qualification Proof File
                </label>
                <input type="file" name="degree" class="form-control p-2 mt-1 border-2" style="border-radius:10px;" required />
              </div>

              <input type="hidden" name="rating" value="0" />
              <input type="hidden" name="responseType" value="redirect" />

              <div class="d-flex gap-3">
                <button type="button" class="btn-submit-action btn-back-muted w-50" onclick="prevStep(4)">
                  <i class="fas fa-chevron-left me-2"></i> Back
                </button>
                <button type="submit" class="btn-submit-action w-50 btn-solid-teal">
                  Register File <i class="fas fa-user-plus ms-2"></i>
                </button>
              </div>
            </div>

          </form>

          <div class="text-center mt-4 pt-3 border-top">
            <p class="small text-muted mb-0">
              Already verified or have an active practitioner login file?
            </p>
            <a href="/doctorLogin" class="auth-switch-link d-inline-block mt-1" style="text-decoration: none;">
              Practitioner Log In Instead
              <i class="fas fa-right-to-bracket ms-1" style="font-size: 13px"></i>
            </a>
          </div>

        </div>
      </div>
    </section>

    <script src="js/home1.js"></script>
    <%- include('includes/footer') %>

    <script>
      function nextStep(step) {
        const currentStepDiv = document.getElementById("step" + step);
        const inputs = currentStepDiv.querySelectorAll("input, select");
        let valid = true;
        
        inputs.forEach((inp) => {
          if (inp.hasAttribute("required") && !inp.value) {
            inp.style.border = "1px solid #ff4d4d";
            valid = false;
          } else {
            inp.style.border = "2px solid #e2e8f0";
          }
        });
        
        if (!valid) return alert("Please fill all fields.");
        
        document.getElementById("step" + step).classList.remove("active");
        document.getElementById("step" + (step + 1)).classList.add("active");
        document.getElementById("step-count").innerText = step + 1;
      }

      function prevStep(step) {
        document.getElementById("step" + step).classList.remove("active");
        document.getElementById("step" + (step - 1)).classList.add("active");
        document.getElementById("step-count").innerText = step - 1;
      }
    </script>
  </body>
</html>