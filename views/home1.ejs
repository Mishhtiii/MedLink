<!doctype html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/home1.css" rel="stylesheet" />
  </head>

  <body>
    <%- include('includes/header') %>

    <% if (req.query.message) { %>
    <script>
      alert('<%= req.query.message %>');
    </script>
    <% } %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Better Care For Better Life.</div>
          <h1 class="hero-title text-white">
            Connect with trusted <br />
            doctors in just a <br />
            few clicks
          </h1>
          <p class="hero-text">
            We provide advanced healthcare solutions designed to improve the
            well-being of every patient. With experienced medical professionals,
            modern technology.
          </p>
        </div>

        <div class="hero-footer d-flex align-items-center mt-5 flex-wrap gap-4">
          <a href="/finddoctor" class="btn-consultation">
            Start Consultation
            <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
          </a>
          
          <div class="review-box d-flex align-items-center">
            <div class="review-avatars me-3">
              <img src="https://i.pravatar.cc/40?u=1" alt="User" class="avatar" />
              <img src="https://i.pravatar.cc/40?u=2" alt="User" class="avatar" />
              <img src="https://i.pravatar.cc/40?u=3" alt="User" class="avatar" />
            </div>
            <div class="review-text text-white">
              <div class="fw-bold">
                4.9/5 <i class="fas fa-star text-warning"></i>
              </div>
              <div class="small opacity-75">More Than 2500 Reviews</div>
            </div>
          </div>

          <div class="medlink-auth-gate ms-lg-auto d-flex gap-2">
            <% if (req.isUser) { %>
              <a href="/profile" class="btn-appointment" style="background-color: transparent; border-color: rgba(255,255,255,0.35);">My Profile</a>
            <% } else { %>
              <a href="/register" class="btn-appointment" style="background-color: transparent; border-color: rgba(255,255,255,0.35);">Join Today!</a>
            <% } %>
            <a href="/doctorRegister" class="btn-appointment" style="background-color: transparent; border-color: rgba(255,255,255,0.35);">Doctor Portal</a>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section py-5">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6 position-relative mb-5 mb-lg-0">
            <div class="about-image-wrapper">
              <img
                src="images/doctor.jpg"
                alt="Our Medical Staff"
                class="img-fluid rounded-4 shadow-lg"
              />

              <div class="about-review-badge">
                <div class="d-flex align-items-center gap-2">
                  <div class="review-avatars">
                    <img src="https://i.pravatar.cc/40?u=1" alt="User" class="avatar border-white" />
                    <img src="https://i.pravatar.cc/40?u=2" alt="User" class="avatar border-white" />
                    <img src="https://i.pravatar.cc/40?u=3" alt="User" class="avatar border-white" />
                  </div>
                  <div class="text-white">
                    <div class="fw-bold h5 mb-0">
                      4.9/5 <i class="fas fa-star text-warning"></i>
                    </div>
                    <div class="small opacity-75">More Than 2500 Reviews</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-6 ps-lg-5">
            <div class="about-badge mb-3">
              <span class="dot-teal me-2"></span> Find Doctors
            </div>
            <h2 class="about-title mb-4">
              Find Experienced Medical Specialists
            </h2>
            <p class="about-description mb-4">
              Find the right doctor for your healthcare needs with ease. Browse
              through our experienced multi-speciality doctors, explore their
              expertise, and connect with trusted medical professionals
              dedicated to providing the best care for you and your family.
            </p>

            <div class="row mb-5">
              <div class="col-md-6 mb-3">
                <div class="d-flex gap-2">
                  <i class="fas fa-check-circle text-info mt-1"></i>
                  <div>
                    <h6 class="fw-bold mb-1">Expert Specialist Doctors</h6>
                    <p class="small text-muted mb-0">
                      Connect with experienced multi-speciality doctors.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <div class="d-flex gap-2">
                  <i class="fas fa-check-circle text-info mt-1"></i>
                  <div>
                    <h6 class="fw-bold mb-1">Easy Doctor Consultation</h6>
                    <p class="small text-muted mb-0">
                      Book consultations quickly with confidence and
                      convenience.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex align-items-center flex-wrap gap-4">
              <a href="/finddoctor" class="btn-consultation">
                Find Doctor
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
              <div class="d-flex align-items-center">
                <img
                  src="https://i.pravatar.cc/50?u=8"
                  alt="Devon Lane"
                  class="rounded-circle me-3 border shadow-sm"
                />
                <div>
                  <h6 class="fw-bold mb-0">Devon Lane</h6>
                  <p class="small text-muted mb-0">
                    Internal Medicine Specialist
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="services-section py-5">
      <div class="container text-center">
        <div class="services-badge mb-3">
          <span class="dot-teal me-2"></span> Our Services
        </div>
        <h2 class="services-main-title mb-5">
          Expert healthcare services for <br />
          better living
        </h2>

        <div class="row g-4 justify-content-center">
          <div class="col-lg-3 col-md-6">
            <div class="service-card" onclick="window.location.href='/pharmacy'">
              <div class="service-card-top">
                <div class="service-icon"><i class="fas fa-dna"></i></div>
                <h5 class="fw-bold">Pharmacy</h5>
                <p class="small text-muted">
                  Our Pharmacy offers quick and convenient access to medicines
                  with easy ordering.
                </p>
              </div>
              <a href="/pharmacy" class="view-details-btn">
                View Details
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="service-card" onclick="window.location.href='/findhospital'">
              <div class="service-card-top">
                <div class="service-icon"><i class="fas fa-flask"></i></div>
                <h5 class="fw-bold">Find Hospitals</h5>
                <p class="small text-muted">
                  Locate the best hospitals in your area in case of emergency.
                </p>
              </div>
              <a href="/findhospital" class="view-details-btn">
                View Details
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="service-card" onclick="window.location.href='/Appointment'">
              <div class="service-card-top">
                <div class="service-icon"><i class="fas fa-peace"></i></div>
                <h5 class="fw-bold">Client Zone</h5>
                <p class="small text-muted">
                  Manage appointments and health records.
                </p>
              </div>
              <a href="/Appointment" class="view-details-btn">
                View Details
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="service-cta-card">
              <h5 class="text-white fw-bold mb-4">
                Your Health Starts With One Call
              </h5>
              <img src="images/doctor.jpg" alt="Doctor" class="cta-doctor-img" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="why-choose-us py-5">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="about-badge mb-3">
              <span class="dot-teal me-2"></span> Why Choose Us
            </div>
            <h2 class="about-title mb-4">
              Why choose us for quality <br />
              healthcare services
            </h2>
            <p class="about-description mb-5">
              We offer expert care across Dentistry, Neurology, Cardiology,
              Orthopedics, Pediatrics, and many more specializations.
            </p>

            <div class="row g-4 align-items-center">
              <div class="col-md-6">
                <div class="stats-card p-4 shadow-sm border rounded-4">
                  <div class="mb-4">
                    <h3 class="fw-bold mb-0">25+</h3>
                    <p class="small text-muted">Years Experience</p>
                  </div>
                  <hr class="opacity-10" />
                  <div class="mt-4">
                    <h3 class="fw-bold mb-0">24/7</h3>
                    <p class="small text-muted">Emergency Support</p>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <img
                  src="images/doctor.jpg"
                  alt="Team"
                  class="img-fluid rounded-4 side-img shadow"
                />
              </div>
            </div>
          </div>

          <div class="col-lg-6 position-relative ps-lg-5 mt-5 mt-lg-0">
            <div class="main-img-container">
              <img
                src="images/doctor.jpg"
                alt="Doctor"
                class="img-fluid rounded-5 main-doctor-img shadow-lg"
              />

              <div class="dept-floating-card shadow">
                <div class="service-icon mb-0 me-3">
                  <i class="fas fa-dna"></i>
                </div>
                <div>
                  <h5 class="fw-bold mb-0">12+</h5>
                  <p class="small text-muted mb-0">Medical Departments</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="how-it-works py-5">
      <div class="container core-features-box">
        <div class="row align-items-center">
          <div class="col-lg-5 mb-5 mb-lg-0">
            <div class="core-badge mb-3">
              <span class="dot-teal me-2"></span> Core Process
            </div>
            <h2 class="text-white display-5 fw-bold mb-4">How It Works?</h2>
            <p class="text-white-50 mb-5">
              Our medical services are designed to provide reliable,
              high-quality care with a strong focus on patient comfort and
              safety.
            </p>
            <a href="/contact" class="btn-consultation">
              Contact Us
              <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
            </a>
          </div>

          <div class="col-lg-7 ps-lg-5">
            <div class="row g-4">
              <div class="col-md-6" onclick="window.location.href='/finddoctor'" style="cursor: pointer;">
                <div class="feature-card">
                  <div class="feature-icon bg-warning">
                    <i class="fas fa-user-doctor"></i>
                  </div>
                  <div class="feature-info">
                    <h6 class="text-white fw-bold mb-1">Find your Doctor</h6>
                    <p class="small text-white-50 mb-0">
                      Choose from variety of our medical specialists
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-md-6" onclick="window.location.href='/findhospital'" style="cursor: pointer;">
                <div class="feature-card">
                  <div class="feature-icon bg-primary">
                    <i class="fas fa-location-dot"></i>
                  </div>
                  <div class="feature-info">
                    <h6 class="text-white fw-bold mb-1">Choose Location</h6>
                    <p class="small text-white-50 mb-0">
                      Find doctors and medical offices in your area
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-md-6" onclick="window.location.href='/Appointment'" style="cursor: pointer;">
                <div class="feature-card">
                  <div class="feature-icon bg-info">
                    <i class="fas fa-calendar-check"></i>
                  </div>
                  <div class="feature-info">
                    <h6 class="text-white fw-bold mb-1">Select Time Slot</h6>
                    <p class="small text-white-50 mb-0">
                      Choose a time that is most convenient for you
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-md-6" onclick="window.location.href='/pharmacy'" style="cursor: pointer;">
                <div class="feature-card">
                  <div class="feature-icon bg-danger">
                    <i class="fas fa-suitcase-medical"></i>
                  </div>
                  <div class="feature-info">
                    <h6 class="text-white fw-bold mb-1">Get a solution</h6>
                    <p class="small text-white-50 mb-0">
                      Hold an appointment either on call or video chat
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section py-5">
      <div class="container text-center">
        <div class="services-badge mb-3">
          <span class="dot-teal me-2"></span> FAQ
        </div>
        <h2 class="services-main-title mb-5">
          Commonly asked questions about <br />
          our medical services
        </h2>

        <div class="faq-card-wrapper shadow-sm">
          <div class="faq-scroll-area">
            <div class="faq-item">
              <h6 class="faq-question">Q1: How can I find nearby hospitals?</h6>
              <p class="faq-answer">
                A: You can use our search feature by entering your location to
                find hospitals near you.
              </p>
            </div>

            <div class="faq-item">
              <h6 class="faq-question">
                Q2: How do I book an appointment with a doctor?
              </h6>
              <p class="faq-answer">
                A: You can book an appointment by visiting the doctor’s profile
                and selecting the available time slots.
              </p>
            </div>

            <div class="faq-item">
              <h6 class="faq-question">
                Q3: What are the hospital services offered?
              </h6>
              <p class="faq-answer">
                A: Our hospitals provide various services including emergency
                care, surgeries, diagnostic testing, and more.
              </p>
            </div>

            <div class="faq-item">
              <h6 class="faq-question">Q4: Can I consult a doctor online?</h6>
              <p class="faq-answer">
                A: Yes, we offer online consultations. Simply choose the "Online
                Consultation" option when booking an appointment.
              </p>
            </div>

            <div class="faq-item">
              <h6 class="faq-question">Q5: Do you accept insurance?</h6>
              <p class="faq-answer">
                A: Yes, we accept a variety of health insurance providers.
                Please check our website for a list of accepted insurance
                companies.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%- include('includes/footer') %>
  </body>
</html>