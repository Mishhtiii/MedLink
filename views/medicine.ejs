<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles/medicine.css" />
    <script src="js/medicine.js"></script>
    <script src="js/medicine-search.js"></script>
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="search-section">
      <div class="container">
        <div class="search-card-wrapper shadow-sm">
          <div class="search-badge mb-2">
            <span class="dot-teal me-2"></span> MedLink Pharmacy
          </div>
          <h2 class="search-title mb-4">Buy Medicines and Essentials</h2>
          <div class="search-bar d-flex align-items-center gap-2">
            <div class="input-group-custom flex-grow-1 position-relative">
              <i class="fas fa-search search-inside-icon"></i>
              <input
                type="text"
                id="medicine-search-input"
                class="form-control-custom"
                placeholder="Search for medicines, multi-vitamins, medical equipment..."
              />
            </div>
            <button id="medicine-search-button" class="btn-search-action">
              <i class="fas fa-magnifying-glass"></i>
            </button>
            <a href="/cart" class="cart-floating-icon ms-3">
              <div class="cart-icon-bg">
                <i class="fa-solid fa-cart-shopping"></i>
                <span id="cart-count">0</span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <div id="search-dialog" class="search-dialog" style="display: none">
      <div class="search-dialog-content rounded-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
          <h3 class="h5 fw-bold mb-0 text-dark">Search Results</h3>
          <span id="search-dialog-close" class="search-dialog-close">&times;</span>
        </div>
        <ul id="search-results-list" class="list-unstyled mb-0"></ul>
      </div>
    </div>

    <section class="hero-shortcuts-section py-4">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-3 col-md-6">
            <div class="shortcut-card">
              <div class="shortcut-img-box">
                <img src="https://i.pinimg.com/736x/91/db/35/91db35d4cb14819cd525f952db2d0d2a.jpg" alt="Order Medicine" />
              </div>
              <h4 class="shortcut-title">Order Medicine</h4>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <a href="/order-by-prescription" style="text-decoration: none;">
              <div class="shortcut-card">
                <div class="shortcut-img-box">
                  <img src="https://i.pinimg.com/736x/25/67/91/2567919dc66fcfd9d932a779df38f00c.jpg" alt="Order by Prescription" />
                </div>
                <h4 class="shortcut-title">Order by Prescription <i class="fas fa-chevron-right small text-info ms-1"></i></h4>
              </div>
            </a>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="shortcut-card">
              <div class="shortcut-img-box">
                <img src="https://i.pinimg.com/736x/24/59/c9/2459c9c43d365d7e0759e0271bcddef5.jpg" alt="Reorder Medicine" />
              </div>
              <h4 class="shortcut-title">Reorder Medicine</h4>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="shortcut-card">
              <div class="shortcut-img-box">
                <img src="https://i.pinimg.com/736x/15/22/b5/1522b54572eb1973d98622f7733648a7.jpg" alt="Shop by Category" />
              </div>
              <h4 class="shortcut-title">Shop by Category</h4>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="slider-wrapper-box">
      <div class="slider-container-box">
        <div class="slides">
          <% sliderImages.forEach(image => { %>
          <a href="<%= image.link %>" class="slide-item-anchor">
            <img src="<%= image.src %>" alt="<%= image.alt %>" />
          </a>
          <% }); %>
        </div>
        <button class="slider-nav-btn prev" onclick="moveSlide(-1)">&#10094;</button>
        <button class="slider-nav-btn next" onclick="moveSlide(1)">&#10095;</button>
      </div>
    </section>

    <section id="ayush-section" class="products-showcase-section py-5">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div class="section-title-block text-start">
            <div class="showcase-badge mb-2"><span class="dot-teal me-2"></span> Natural Healing</div>
            <h2 class="section-main-heading">Best of Ayurvedic, Siddha & Unani</h2>
          </div>
          <div class="slider-controls-group">
            <button class="prev-slide track-btn me-2">&#10094;</button>
            <button class="next-slide track-btn">&#10095;</button>
          </div>
        </div>
        <div class="slider-overflow-container">
          <div class="product-slider">
            <% medicines.forEach(medicine => { %>
            <div
              class="product-card"
              data-name="<%= medicine.name %>"
              data-price="<%= medicine.price %>"
              data-image="<%= medicine.image %>"
              data-oldprice="<%= medicine.oldPrice %>"
            >
              <div class="product-img-wrapper">
                <img src="<%= medicine.image %>" alt="<%= medicine.name %>" />
                <span class="discount-pill">
                  <%= ((medicine.oldPrice - medicine.price) / medicine.oldPrice * 100).toFixed(1) %>% OFF
                </span>
              </div>
              <div class="product-body">
                <h3 class="product-title-text"><%= medicine.name %></h3>
                <div class="price-box-wrapper">
                  <span class="current-price-tag">₹ <%= medicine.price.toFixed(2) %></span>
                  <span class="old-price-tag">₹ <%= medicine.oldPrice.toFixed(2) %></span>
                </div>
                <button class="add-to-cart btn-action-trigger">ADD TO CART</button>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </section>

    <section id="fitness-section" class="products-showcase-section py-5 gray-bg-split">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div class="section-title-block text-start">
            <div class="showcase-badge mb-2"><span class="dot-teal me-2"></span> Active Life</div>
            <h2 class="section-main-heading">Deals on Fitness</h2>
          </div>
          <div class="slider-controls-group">
            <button class="prev-slide track-btn me-2">&#10094;</button>
            <button class="next-slide track-btn">&#10095;</button>
          </div>
        </div>
        <div class="slider-overflow-container">
          <div class="product-slider">
            <% fitnessDeals.forEach(deal => { %>
            <div
              class="product-card"
              data-name="<%= deal.name %>"
              data-price="<%= deal.price %>"
              data-image="<%= deal.image %>"
              data-oldprice="<%= deal.oldPrice %>"
            >
              <div class="product-img-wrapper">
                <img src="<%= deal.image %>" alt="<%= deal.name %>" />
                <span class="discount-pill highlight-pill">
                  <%= ((deal.oldPrice - deal.price) / deal.oldPrice * 100).toFixed(0) %>% OFF
                </span>
              </div>
              <div class="product-body">
                <h3 class="product-title-text"><%= deal.name %></h3>
                <div class="price-box-wrapper">
                  <span class="current-price-tag">₹ <%= deal.price.toFixed(2) %></span>
                  <span class="old-price-tag">₹ <%= deal.oldPrice.toFixed(2) %></span>
                </div>
                <button class="add-to-cart1 btn-action-trigger">ADD TO CART</button>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <section id="personal-care-section" class="products-showcase-section py-5">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div class="section-title-block text-start">
            <div class="showcase-badge mb-2"><span class="dot-teal me-2"></span> Self Care</div>
            <h2 class="section-main-heading">Best Sellers in Personal Care</h2>
          </div>
          <div class="slider-controls-group">
            <button class="prev-slide track-btn me-2">&#10094;</button>
            <button class="next-slide track-btn">&#10095;</button>
          </div>
        </div>
        <div class="slider-overflow-container">
          <div class="product-slider">
            <% personalCareProducts.forEach(item => { %>
            <div
              class="product-card"
              data-name="<%= item.name %>"
              data-price="<%= item.price %>"
              data-image="<%= item.image %>"
              data-oldprice="<%= item.oldPrice %>"
            >
              <div class="product-img-wrapper">
                <img src="<%= item.image %>" alt="<%= item.name %>" />
                <span class="discount-pill">
                  <%= ((item.oldPrice - item.price) / item.oldPrice * 100).toFixed(0) %>% OFF
                </span>
              </div>
              <div class="product-body">
                <h3 class="product-title-text"><%= item.name %></h3>
                <div class="price-box-wrapper">
                  <span class="current-price-tag">₹ <%= item.price.toFixed(2) %></span>
                  <span class="old-price-tag">₹ <%= item.oldPrice.toFixed(2) %></span>
                </div>
                <button class="add-to-cart btn-action-trigger">ADD TO CART</button>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <section class="products-showcase-section py-5 gray-bg-split">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div class="section-title-block text-start">
            <div class="showcase-badge mb-2"><span class="dot-teal me-2"></span> Medical Super Savers</div>
            <h2 class="section-main-heading">Surgical Super Savers</h2>
          </div>
          <div class="slider-controls-group">
            <button class="prev-slide track-btn me-2">&#10094;</button>
            <button class="next-slide track-btn">&#10095;</button>
          </div>
        </div>
        <div class="slider-overflow-container">
          <div class="product-slider">
            <% surgicalDeals.forEach(item => { %>
            <div
              class="product-card"
              data-name="<%= item.name %>"
              data-price="<%= item.price %>"
              data-image="<%= item.image %>"
              data-oldprice="<%= item.oldPrice %>"
            >
              <div class="product-img-wrapper">
                <img src="<%= item.image %>" alt="<%= item.name %>" />
                <span class="discount-pill highlight-pill">
                  <%= ((item.oldPrice - item.price) / item.oldPrice * 100).toFixed(0) %>% OFF
                </span>
              </div>
              <div class="product-body">
                <h3 class="product-title-text"><%= item.name %></h3>
                <div class="price-box-wrapper">
                  <span class="current-price-tag">₹ <%= item.price.toFixed(2) %></span>
                  <span class="old-price-tag">₹ <%= item.oldPrice.toFixed(2) %></span>
                </div>
                <button class="add-to-cart1 btn-action-trigger">ADD TO CART</button>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </section>

    <section class="popular-categories py-5">
      <div class="container text-center">
        <div class="showcase-badge mb-3"><span class="dot-teal me-2"></span> Top Manufacturers</div>
        <h2 class="section-main-heading mb-5">Brands in Focus</h2>
        <div class="row g-4 justify-content-center">
          <div class="col-lg-3 col-md-6">
            <a href="https://www.cetaphil.in/" target="_blank" rel="noopener noreferrer" class="brand-link-box">
              <div class="category-box">
                <img src="https://ik.imagekit.io/anscommerce/image/tr:e-sharpen-01,h-1080,w-1080,cm-pad_resize/data/galderma/08may2024/F43000_1.jpg" alt="Cetaphil" />
                <h3 class="brand-title">Cetaphil</h3>
              </div>
            </a>
          </div>
          <div class="col-lg-3 col-md-6">
            <a href="https://www.accu-chek.in/" target="_blank" rel="noopener noreferrer" class="brand-link-box">
              <div class="category-box">
                <img src="https://m.media-amazon.com/images/I/61lBgAv8UDL.jpg" alt="Accu-check" />
                <h3 class="brand-title">Accu-check</h3>
              </div>
            </a>
          </div>
          <div class="col-lg-3 col-md-6">
            <a href="https://www.muscleblaze.com/" target="_blank" rel="noopener noreferrer" class="brand-link-box">
              <div class="category-box">
                <img src="https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcS1xPAk_qawI2gAoYza2kjuhHQwR9tDsFzNk_m0Mu4c5jCoCHVSQYNY6hKGkfVFwvydlEttZNy897kRV2ATfD_Sk12cXL1uPPZs7bkdyjWTZrSQCtjHtp21" alt="MuscleBlaze" />
                <h3 class="brand-title">MuscleBlaze</h3>
              </div>
            </a>
          </div>
          <div class="col-lg-3 col-md-6">
            <a href="https://www.sebamedindia.com/" target="_blank" rel="noopener noreferrer" class="brand-link-box">
              <div class="category-box personal-care">
                <img src="https://m.media-amazon.com/images/I/717v4zE201L.jpg" alt="Sebamed" />
                <h3 class="brand-title">Sebamed</h3>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="products-showcase-section py-5 gray-bg-split">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div class="section-title-block text-start">
            <div class="showcase-badge mb-2"><span class="dot-teal me-2"></span> Hardware Systems</div>
            <h2 class="section-main-heading">Spotlight Deals on Devices</h2>
          </div>
          <div class="slider-controls-group">
            <button class="prev-slide track-btn me-2">&#10094;</button>
            <button class="next-slide track-btn">&#10095;</button>
          </div>
        </div>
        <div class="slider-overflow-container" id="devices-section">
          <div class="product-slider">
            <% surgicalDevices.forEach(product => { %>
            <div
              class="product-card"
              data-name="<%= product.name %>"
              data-price="<%= product.price %>"
              data-image="<%= product.image %>"
              data-oldprice="<%= product.oldPrice %>"
            >
              <div class="product-img-wrapper">
                <img src="<%= product.image %>" alt="<%= product.name %>" />
                <span class="discount-pill">
                  GET <%= ((product.oldPrice - product.price) / product.oldPrice * 100).toFixed(0) %>% off
                </span>
              </div>
              <div class="product-body">
                <h3 class="product-title-text"><%= product.name %></h3>
                <div class="price-box-wrapper">
                  <span class="current-price-tag">₹ <%= product.price.toFixed(2) %></span>
                  <span class="old-price-tag">₹ <%= product.oldPrice.toFixed(2) %></span>
                </div>
                <button class="add-to-cart btn-action-trigger">ADD TO CART</button>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <%- include('includes/footer') %>
  </body>
</html>