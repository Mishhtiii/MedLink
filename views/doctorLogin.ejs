<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/login.css" rel="stylesheet" />
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Medical Practitioner Gateway</div>
          <h1 class="hero-title text-white">
            Practitioner Login <br />
            To Your Clinical <br />
            Management Workspace
          </h1>
          <p class="hero-text">
            Access your secure medical dashboard to coordinate assigned patient appointments, 
            review diagnostic history portfolios, and update dynamic availability slot streams seamlessly.
          </p>
        </div>
      </div>
    </section>

    <section class="auth-form-section py-5">
      <div
        class="container bg-white shadow-sm border rounded-5 p-4 p-lg-5"
        style="
          margin-top: -40px;
          position: relative;
          z-index: 10;
          max-width: 600px;
        "
      >
        <div class="form-container">
          <div class="about-badge mb-3">
            <span class="dot-teal me-2"></span> Personnel Verification
          </div>
          <h2 class="form-main-title mb-2">Doctor Login</h2>
          <p class="text-muted small mb-4">
            Enter your registered physician parameters to initialize secure workspace console nodes.
          </p>

          <form
            action="/api/doctors/login"
            method="POST"
            class="contact-form d-flex flex-column gap-3"
          >
            <% if (typeof error !== 'undefined' && error === 'InvalidCredentials') { %>
            <div
              class="error-message p-3 mb-2 rounded-3 text-center small"
              style="color: #ffffff; background-color: #ff4d4d; font-weight: 500;"
            >
              <i class="fas fa-circle-exclamation me-2"></i> Invalid doctor credentials or username mismatch. Please try again.
            </div>
            <% } %>

            <div class="form-group-custom position-relative">
              <label for="username" class="form-label-text">Physician Username ID</label>
              <div class="position-relative">
                <i class="fas fa-user-md input-inside-icon"></i>
                <input
                  type="text"
                  id="username"
                  name="username"
                  class="form-input-control"
                  placeholder="Enter your practitioner username"
                  required
                />
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="login-password" class="form-label-text">Security Code ID</label>
              <div class="position-relative">
                <i class="fas fa-lock input-inside-icon"></i>
                <input
                  type="password"
                  id="login-password"
                  name="password"
                  minlength="8"
                  class="form-input-control"
                  placeholder="Enter your security passcode"
                  required
                />
              </div>
            </div>

            <div class="text-end mt-1">
              <a href="/reset" class="forgot-pass-link" style="text-decoration: none;">Forgot Password?</a>
            </div>

            <input type="hidden" name="responseType" value="redirect" />

            <div class="form-group-custom mt-3">
              <button type="submit" class="btn-submit-action w-100">
                Secure Practitioner Login
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </button>
            </div>

            <div class="social-auth-wrapper text-center mt-4 pt-2 border-top">
              <p class="small text-muted mb-3">Or log in via verified federated channels</p>
              <div class="socialicons d-flex justify-content-center gap-3">
                <a href="https://accounts.google.com/" target="_blank" class="social-icon-btn">
                  <i class="bx bxl-google"></i>
                </a>
                <a href="https://www.linkedin.com/login" target="_blank" class="social-icon-btn">
                  <i class="bx bxl-linkedin"></i>
                </a>
              </div>
            </div>
          </form>

          <div class="text-center mt-4 pt-3 border-top">
            <p class="small text-muted mb-0">
              Not registered as a medical consultant on our grid yet?
            </p>
            <a href="/doctorRegister" class="auth-switch-link d-inline-block mt-1" style="text-decoration: none;">
              Apply For Practitioner License Account
              <i class="fas fa-user-plus ms-1" style="font-size: 13px"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <script src="js/home1.js"></script>
    <%- include('includes/footer') %>
  </body>
</html>