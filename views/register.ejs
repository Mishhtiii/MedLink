<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/register.css" rel="stylesheet" />
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Join MedLink Network</div>
          <h1 class="hero-title text-white">
            Create Your Account <br />
            & Access Better <br />
            Healthcare Options
          </h1>
          <p class="hero-text">
            Get linked to top-rated multi-speciality medical practitioners, buy
            medicines online, and track your diagnostics profile instantly. Sign
            up today and manage your wellness parameters seamlessly.
          </p>
        </div>
      </div>
    </section>

    <section class="auth-form-section py-5">
      <div
        class="container bg-white shadow-sm border rounded-5 p-4 p-lg-5"
        style="
          margin-top: -40px;
          position: relative;
          z-index: 10;
          max-width: 650px;
        "
      >
        <div class="form-container">
          <div class="about-badge mb-3">
            <span class="dot-teal me-2"></span> Patient Enrollment
          </div>
          <h2 class="form-main-title mb-2">Create Account</h2>
          <p class="text-muted small mb-4">
            Please fill in your authentic parameters to configure your personal
            health records node.
          </p>

          <form
            action="/api/users/register"
            id="registerform"
            method="POST"
            class="contact-form d-flex flex-column gap-3"
          >
            <% if (typeof req !== 'undefined' && req.query.error === "UsernameTaken") { %>
            <div
              class="error-message p-3 mb-1 rounded-3 text-center small"
              style="color: #ffffff; background-color: #ff4d4d; font-weight: 500;"
            >
              <i class="fas fa-circle-exclamation me-2"></i> Username already taken. Please try another one.
            </div>
            <% } else if (typeof req !== 'undefined' && req.query.error === "WeakPassword") { %>
            <div
              class="error-message p-3 mb-1 rounded-3 text-center small"
              style="color: #ffffff; background-color: #ff4d4d; font-weight: 500;"
            >
              <i class="fas fa-key me-2"></i> Password is too weak. Please use additional character variations.
            </div>
            <% } %>

            <div class="form-group-custom position-relative">
              <label for="register-name" class="form-label-text">Full Name</label>
              <div class="position-relative">
                <i class="fas fa-user-rectangle input-inside-icon"></i>
                <input
                  type="text"
                  id="register-name"
                  name="name"
                  class="form-input-control"
                  placeholder="Enter your full name"
                  required
                />
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="register-username" class="form-label-text">Username Profile ID</label>
              <div class="position-relative">
                <i class="fas fa-user input-inside-icon"></i>
                <input
                  type="text"
                  id="register-username"
                  name="username"
                  class="form-input-control"
                  placeholder="Create a unique username"
                  required
                />
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="register-email" class="form-label-text">Email Address</label>
              <div class="position-relative">
                <i class="fas fa-envelope input-inside-icon"></i>
                <input
                  type="email"
                  id="register-email"
                  name="email"
                  class="form-input-control"
                  placeholder="Enter your valid email"
                  required
                />
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="register-password" class="form-label-text">Passcode Configuration</label>
              <div class="position-relative">
                <i class="fas fa-lock input-inside-icon"></i>
                <input
                  type="password"
                  id="register-password"
                  name="password"
                  class="form-input-control"
                  placeholder="Create a strong password"
                  required
                />
              </div>
            </div>

            <input type="hidden" name="responseType" value="redirect" />

            <div class="form-group-custom mt-4">
              <button type="submit" class="btn-submit-action w-100">
                Register Account
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </button>
            </div>

            <div class="social-auth-wrapper text-center mt-4 pt-2 border-top">
              <p class="small text-muted mb-3">Or register with social platforms</p>
              <div class="socialicons d-flex justify-content-center gap-3">
                <a href="https://accounts.google.com/" target="_blank" class="social-icon-btn">
                  <i class="bx bxl-google"></i>
                </a>
                <a href="https://www.facebook.com/" target="_blank" class="social-icon-btn">
                  <i class="bx bxl-facebook"></i>
                </a>
                <a href="https://github.com/login" target="_blank" class="social-icon-btn">
                  <i class="bx bxl-github"></i>
                </a>
                <a href="https://www.linkedin.com/login" target="_blank" class="social-icon-btn">
                  <i class="bx bxl-linkedin"></i>
                </a>
              </div>
            </div>
          </form>

          <div class="text-center mt-4 pt-3 border-top">
            <p class="small text-muted mb-0">
              Already registered under our healthcare server networks?
            </p>
            <a href="/login" class="auth-switch-link d-inline-block mt-1" style="text-decoration: none;">
              Log In Instead
              <i class="fas fa-right-to-bracket ms-1" style="font-size: 13px"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <script src="js/home1.js"></script>
    <%- include('includes/footer') %>
  </body>
</html>