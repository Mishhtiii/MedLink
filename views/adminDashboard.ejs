<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - MedLink</title>
    <link rel="stylesheet" href="/styles/reset.css" />
    <link rel="stylesheet" href="/styles/navbar.css" />
    <link rel="stylesheet" href="/styles/adminDashboard.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  </head>
  <body>
    <%- include('includes/adminHeader') %>

    <section class="home" id="home">
      <div class="swiper home-slider">
        <div class="swiper-wrapper">
          <div class="box">
            <div class="content text-start">
              <div class="hero-badge-panel mb-3">
                <span class="dot-teal me-2"></span> Admin Panel
              </div>
              <h3>
                Welcome, Administrator <br />
                & Operations Desk
              </h3>
              <p>
                Monitor platform performance, verify incoming medical doctor
                licenses, manage registered patient records, and coordinate
                doctor appointment bookings.
              </p>
              <div class="button-group-row d-flex gap-3 flex-wrap mt-4">
                <a
                  href="#workspace"
                  class="btn-theme-solid"
                  onclick="switchTab('pending-doctors')"
                  >Pending Approvals</a
                >
                <a
                  href="#workspace"
                  class="btn-theme-outline"
                  onclick="switchTab('appointments')"
                  >View Appointments</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="dashboard-core-wrapper py-5" id="workspace">
      <div class="container">
        <div
          class="practitioner-profile-card bg-white border shadow-sm p-4 rounded-5 mb-5 d-flex flex-wrap align-items-center justify-content-between gap-3"
        >
          <div class="d-flex align-items-center gap-3">
            <div
              class="admin-avatar-placeholder d-flex align-items-center justify-content-center text-white font-bold rounded-circle border shadow-sm"
            >
              <i class="fas fa-user-shield"></i>
            </div>
            <div class="text-start">
              <div class="showcase-badge mb-1">
                <span class="dot-teal me-2"></span> Session Authenticated
              </div>
              <h2 class="fw-bold text-dark mb-0">
                System Administrator Control Center
              </h2>
              <div class="d-flex flex-wrap gap-3 mt-1 text-muted small">
                <span
                  ><i class="fas fa-lock text-info me-1"></i> Root Administrator
                  Access</span
                >
              </div>
            </div>
          </div>
        </div>

        <div class="row g-4 mb-5">
          <div class="col-md-4">
            <div
              class="metric-status-card bg-white border shadow-sm p-4 rounded-5 text-start d-flex align-items-center gap-3"
            >
              <div
                class="metric-icon text-warning rounded-4 d-flex align-items-center justify-content-center"
              >
                <i class="fas fa-user-md"></i>
              </div>
              <div>
                <h4 class="text-muted small fw-medium mb-1">
                  Verification Queue
                </h4>
                <p class="h5 fw-bold text-dark mb-0">Pending Approvals</p>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div
              class="metric-status-card bg-white border shadow-sm p-4 rounded-5 text-start d-flex align-items-center gap-3"
            >
              <div
                class="metric-icon text-success rounded-4 d-flex align-items-center justify-content-center"
              >
                <i class="fas fa-users"></i>
              </div>
              <div>
                <h4 class="text-muted small fw-medium mb-1">Total Users</h4>
                <p class="h5 fw-bold text-dark mb-0">Registered Patients</p>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div
              class="metric-status-card bg-white border shadow-sm p-4 rounded-5 text-start d-flex align-items-center gap-3"
            >
              <div
                class="metric-icon text-danger rounded-4 d-flex align-items-center justify-content-center"
              >
                <i class="fas fa-file-invoice-dollar"></i>
              </div>
              <div>
                <h4 class="text-muted small fw-medium mb-1">
                  Activity Overview
                </h4>
                <p class="h5 fw-bold text-dark mb-0">Total Bookings</p>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-lg-3">
            <div
              class="dashboard-nav bg-white border shadow-sm p-3 rounded-5 d-flex flex-column gap-2 text-start"
            >
              <span class="small text-muted px-3 py-1 uppercase tracking-wider"
                >Navigation Menu</span
              >

              <button
                class="nav-item tab-link active"
                data-tab="pending-doctors"
              >
                <i class="fas fa-clock me-2"></i> Pending Doctors
              </button>
              <button class="nav-item tab-link" data-tab="users">
                <i class="fas fa-users me-2"></i> Manage Patients
              </button>
              <button class="nav-item tab-link" data-tab="doctors">
                <i class="fas fa-user-md me-2"></i> Manage Doctors
              </button>
              <button class="nav-item tab-link" data-tab="appointments">
                <i class="fas fa-calendar-check me-2"></i> Appointments
              </button>

              <hr class="my-2 opacity-10" />
              <a
                href="/api/users/logout"
                class="nav-item text-danger decoration-none"
              >
                <i class="fas fa-sign-out-alt me-2"></i> Log Out
              </a>
            </div>
          </div>

          <div class="col-lg-9">
            <div
              class="dashboard-content bg-white border shadow-sm p-4 p-md-5 rounded-5 text-start min-height-lock"
            >
              <div id="pending-doctors" class="tab-content active">
                <h3 class="panel-heading-title mb-2">
                  <i class="fas fa-user-clock text-info me-2"></i> Pending
                  Doctor Approvals
                </h3>
                <p class="small text-muted mb-4">
                  Review professional credential uploads and license details
                  before granting platform access.
                </p>
                <div
                  id="pending-doctors-list"
                  class="d-flex flex-column gap-3"
                ></div>
              </div>

              <div id="users" class="tab-content">
                <h3 class="panel-heading-title mb-2">
                  <i class="fas fa-users-cog text-info me-2"></i> Registered
                  Patient Accounts
                </h3>
                <p class="small text-muted mb-4">
                  View verified patient profiles or delete accounts due to
                  platform violations.
                </p>
                <div class="table-responsive">
                  <div id="users-list"></div>
                </div>
              </div>

              <div id="doctors" class="tab-content">
                <h3 class="panel-heading-title mb-2">
                  <i class="fas fa-stethoscope text-info me-2"></i> Activated
                  Doctors
                </h3>
                <p class="small text-muted mb-4">
                  Full list of all active, approved professional healthcare
                  specialists on MedLink.
                </p>
                <div class="table-responsive">
                  <div id="doctors-list"></div>
                </div>
              </div>

              <div id="appointments" class="tab-content">
                <h3 class="panel-heading-title mb-2">
                  <i class="fas fa-notes-medical text-info me-2"></i>
                  Appointment History
                </h3>
                <p class="small text-muted mb-4">
                  Live tracking of active and historic doctor consultations
                  scheduled across the application.
                </p>
                <div class="table-responsive">
                  <div id="appointments-list"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%- include('includes/adminFooter') %>

    <script>
      function switchTab(tabId) {
        const tabButton = $(`.tab-link[data-tab="${tabId}"]`);
        if (tabButton.length) {
          tabButton.click();
        }
      }

      $(document).ready(function () {
        $(".tab-link").on("click", function () {
          const tabId = $(this).data("tab");

          $(".tab-link").removeClass("active");
          $(this).addClass("active");

          $(".tab-content").removeClass("active");
          $("#" + tabId).addClass("active");

          loadTabData(tabId);
        });

        loadTabData("pending-doctors");

        function loadTabData(tabId) {
          switch (tabId) {
            case "pending-doctors":
              loadPendingDoctors();
              break;
            case "users":
              loadUsers();
              break;
            case "doctors":
              loadDoctors();
              break;
            case "appointments":
              loadAppointments();
              break;
          }
        }

        function loadPendingDoctors() {
          $.ajax({
            url: "/api/admin/pending-doctors",
            method: "GET",
            xhrFields: { withCredentials: true },
            success: function (data) {
              let html = "";
              if (data.length === 0) {
                html =
                  "<div class='p-4 bg-light text-center rounded-4 text-muted'><i class='fas fa-folder-open mb-2 d-block h4'></i>No pending registration requests found.</div>";
              } else {
                data.forEach((doctor) => {
                  const imagePath = doctor.image
                    ? `/images/${doctor.image}`
                    : "/images/doctor.png";
                  const licensePath = `/images/${doctor.license}`;
                  const degreePath = `/images/${doctor.degree}`;

                  html += `
            <div class="admin-approval-card p-4 border rounded-4 bg-light-split mb-3 shadow-sm">
              <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3 border-bottom pb-3">
                <div class="d-flex gap-3 align-items-center">
                  <img src="${imagePath}" alt="Dr. ${doctor.name}" class="rounded-circle border" style="width: 65px; height: 65px; object-fit: cover;" onerror="this.src='/images/doctor.png'">
                  <div class="text-start">
                    <h4 class="fw-bold text-dark h6 mb-1">Dr. ${doctor.name}</h4>
                    <p class="small text-muted mb-0">
                      <span class="me-3"><i class="fas fa-stethoscope text-info me-1"></i> ${doctor.specialization}</span>
                      <span><i class="fas fa-briefcase text-info me-1"></i> ${doctor.experience} Years Experience</span>
                    </p>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-2 native-action-wrapper">
                  <button class="btn approve-btn py-2 px-3 rounded-3 btn-success text-white" data-id="${doctor._id}"><i class="fas fa-check-circle me-1"></i> Approve Doctor</button>
                  <button class="btn reject-btn py-2 px-3 rounded-3 btn-danger text-white" data-id="${doctor._id}"><i class="fas fa-times-circle me-1"></i> Reject</button>
                </div>
              </div>

              <div class="row g-3 text-start small text-muted mb-3">
                <div class="col-md-4 col-sm-6">
                  <i class="fas fa-envelope text-info me-1" style="width: 18px;"></i> <strong>Email:</strong> ${doctor.email}
                </div>
                <div class="col-md-4 col-sm-6">
                  <i class="fas fa-user-tag text-info me-1" style="width: 18px;"></i> <strong>Username:</strong> ${doctor.username}
                </div>
                <div class="col-md-4 col-sm-6">
                  <i class="fas fa-graduation-cap text-info me-1" style="width: 18px;"></i> <strong>Qualification:</strong> ${doctor.qualification}
                </div>
                <div class="col-md-4 col-sm-6">
                  <i class="fas fa-hospital text-info me-1" style="width: 18px;"></i> <strong>Hospital:</strong> ${doctor.hospital}
                </div>
                <div class="col-md-4 col-sm-6">
                  <i class="fas fa-map-marker-alt text-info me-1" style="width: 18px;"></i> <strong>Location:</strong> ${doctor.location}
                </div>
                <div class="col-md-4 col-sm-6">
                  <i class="fas fa-phone text-info me-1" style="width: 18px;"></i> <strong>Phone:</strong> ${doctor.phone}
                </div>
                <div class="col-md-4 col-sm-6">
                  <i class="fas fa-rupee-sign text-info me-1" style="width: 18px;"></i> <strong>Fees:</strong> ₹${doctor.fees}
                </div>
                <div class="col-md-4 col-sm-6">
                  <i class="fas fa-id-card text-warning me-1" style="width: 18px;"></i> <strong>Aadhar Number:</strong> <span class="text-dark fw-medium">[Aadhaar Redacted]</span>
                </div>
                <div class="col-md-8 col-sm-12">
                  <i class="fas fa-calendar-alt text-info me-1" style="width: 18px;"></i> <strong>Availability:</strong> ${doctor.availability}
                </div>
              </div>

              <div class="border-top pt-3 text-start">
                <h5 class="h6 mb-2 fw-bold text-dark"><i class="fas fa-file-medical text-secondary me-1"></i> Verification Documents:</h5>
                <div class="d-flex gap-3 flex-wrap">
                  <a href="${licensePath}" target="_blank" class="btn btn-sm btn-outline-primary rounded-3 px-3">
                    <i class="fas fa-certificate me-1"></i> View Medical License
                  </a>
                  <a href="${degreePath}" target="_blank" class="btn btn-sm btn-outline-primary rounded-3 px-3">
                    <i class="fas fa-user-graduate me-1"></i> View Degree Certificate
                  </a>
                </div>
              </div>
            </div>
          `;
                });
              }
              $("#pending-doctors-list").html(html);
            },
            error: function (err) {
              $("#pending-doctors-list").html(
                '<div class="p-3 text-danger text-center bg-light rounded-3">Failed to load pending request lists.</div>',
              );
            },
          });
        }

        function loadUsers() {
          $.ajax({
            url: "/api/admin/users",
            method: "GET",
            xhrFields: { withCredentials: true },
            success: function (data) {
              let html = `
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Patient Name</th>
                      <th>Email Address</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
              `;
              if (data.length > 0) {
                data.forEach((user) => {
                  html += `
                    <tr>
                      <td class="fw-medium text-dark">${user.name}</td>
                      <td class="text-secondary">${user.email}</td>
                      <td class="text-end"><button class="btn delete-btn delete-user-btn py-1 px-3 rounded-3" data-id="${user._id}"><i class="fas fa-trash-alt me-1"></i> Delete Account</button></td>
                    </tr>
                  `;
                });
              } else {
                html +=
                  '<tr><td colspan="3" class="text-center text-muted p-4">No registered patient accounts found in the database.</td></tr>';
              }
              html += "</tbody></table>";
              $("#users-list").html(html);
            },
            error: function (err) {
              $("#users-list").html(
                '<div class="p-3 text-danger text-center bg-light rounded-3">Failed to sync patient database records.</div>',
              );
            },
          });
        }

        function loadDoctors() {
          $.ajax({
            url: "/api/admin/doctors",
            method: "GET",
            xhrFields: { withCredentials: true },
            success: function (data) {
              let html = `
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Doctor Name</th>
                      <th>Specialization</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
              `;
              if (data.length > 0) {
                data.forEach((doctor) => {
                  html += `
                    <tr>
                      <td class="fw-medium text-dark">Dr. ${doctor.name}</td>
                      <td><span class="badge rounded-pill bg-light text-dark border px-3 py-1">${doctor.field}</span></td>
                      <td class="text-end"><button class="btn delete-btn delete-doctor-btn py-1 px-3 rounded-3" data-id="${doctor._id}"><i class="fas fa-user-slash me-1"></i> Revoke Access</button></td>
                    </tr>
                  `;
                });
              } else {
                html +=
                  '<tr><td colspan="3" class="text-center text-muted p-4">No approved medical specialists found.</td></tr>';
              }
              html += "</tbody></table>";
              $("#doctors-list").html(html);
            },
            error: function (err) {
              $("#doctors-list").html(
                '<div class="p-3 text-danger text-center bg-light rounded-3">Failed to sync doctor records.</div>',
              );
            },
          });
        }

        function loadAppointments() {
          $.ajax({
            url: "/api/admin/appointments",
            method: "GET",
            xhrFields: { withCredentials: true },
            success: function (data) {
              let html = `
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Patient Name</th>
                      <th>Assigned Doctor</th>
                      <th>Appointment Date</th>
                      <th>Time Slot</th>
                    </tr>
                  </thead>
                  <tbody>
              `;
              if (data.length > 0) {
                data.forEach((appointment) => {
                  html += `
                    <tr>
                      <td class="fw-medium text-dark">${appointment.user.name}</td>
                      <td class="text-secondary">Dr. ${appointment.doctor.name}</td>
                      <td><i class="far fa-calendar-alt text-muted me-1"></i> ${new Date(appointment.date).toLocaleDateString()}</td>
                      <td><span class="badge rounded-pill bg-dark text-white px-3 py-1"><i class="far fa-clock me-1"></i> ${appointment.time}</span></td>
                    </tr>
                  `;
                });
              } else {
                html +=
                  '<tr><td colspan="4" class="text-center text-muted p-4">No appointments scheduled on the platform.</td></tr>';
              }
              html += "</tbody></table>";
              $("#appointments-list").html(html);
            },
            error: function (err) {
              $("#appointments-list").html(
                '<div class="p-3 text-danger text-center bg-light rounded-3">Failed to load apppointments data.</div>',
              );
            },
          });
        }

        // Action Trigger Event Binding Handlers
        $(document).on("click", ".approve-btn", function () {
          const id = $(this).data("id");
          $.ajax({
            url: `/api/admin/approve-doctor/${id}`,
            method: "POST",
            xhrFields: { withCredentials: true },
            success: function () {
              alert("Success: Practitioner has been approved successfully.");
              loadPendingDoctors();
            },
            error: function () {
              alert("Error: Failed to complete doctor verification.");
            },
          });
        });

        $(document).on("click", ".reject-btn", function () {
          const id = $(this).data("id");
          $.ajax({
            url: `/api/admin/reject-doctor/${id}`,
            method: "DELETE",
            xhrFields: { withCredentials: true },
            success: function () {
              alert(
                "Doctor application rejected and registration data deleted.",
              );
              loadPendingDoctors();
            },
            error: function () {
              alert("Error processing rejection.");
            },
          });
        });

        $(document).on("click", ".delete-user-btn", function () {
          const id = $(this).data("id");
          if (
            confirm(
              "Are you sure you want to permanently delete this patient's account?",
            )
          ) {
            $.ajax({
              url: `/api/admin/users/${id}`,
              method: "DELETE",
              xhrFields: { withCredentials: true },
              success: function () {
                alert("Patient account successfully deleted.");
                loadUsers();
              },
              error: function () {
                alert("Error deleting the account. Please try again.");
              },
            });
          }
        });

        $(document).on("click", ".delete-doctor-btn", function () {
          const id = $(this).data("id");
          if (
            confirm(
              "Are you sure you want to completely revoke platform access for this doctor?",
            )
          ) {
            $.ajax({
              url: `/api/admin/doctors/${id}`,
              method: "DELETE",
              xhrFields: { withCredentials: true },
              success: function () {
                alert("Doctor profile has been removed.");
                loadDoctors();
              },
              error: function () {
                alert("Error revoking doctor access.");
              },
            });
          }
        });
      });
    </script>
  </body>
</html>
