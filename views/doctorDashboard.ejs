<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./includes/head') %>
    <title>Doctor Dashboard - MedLink</title>
    <link rel="stylesheet" href="/styles/reset.css" />
    <link rel="stylesheet" href="/styles/navbar.css" />
    <link rel="stylesheet" href="/styles/doctorDashboard.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include('./includes/doctorHeader') %>

    <section class="home" id="home">
      <div class="swiper home-slider">
        <div class="swiper-wrapper">
          <div
            class="box"
            style="
              background:
                linear-gradient(rgba(7, 35, 49, 0.75), rgba(7, 35, 49, 0.8)),
                url(&quot;images/scope.jpg&quot;) no-repeat;
              background-size: cover;
              background-position: center;
            "
          >
            <div class="content text-start">
              <div class="hero-badge-panel mb-3">
                <span class="dot-teal me-2"></span> Clinical Console Terminal
              </div>
              <h3>
                Practitioner Control <br />
                &amp; Operational Desk
              </h3>
              <p>
                Streamline your consultation pipelines dynamically. Monitor live
                patient queuing registries, update scheduling availability
                slots, and configure care allocations from a single secure
                endpoint.
              </p>
              <div class="button-group-row d-flex gap-3 flex-wrap mt-4">
                <a
                  href="#workspace"
                  class="btn-theme-solid"
                  onclick="showSection('appointments')"
                  >View Appointments</a
                >
                <a
                  href="#workspace"
                  class="btn-theme-outline"
                  onclick="showSection('slots')"
                  >Manage My Slots</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="dashboard-core-wrapper py-5" id="workspace">
      <div class="container">
        <div
          class="practitioner-profile-card bg-white border shadow-sm p-4 rounded-5 mb-5 d-flex flex-wrap align-items-center justify-content-between gap-3"
          style="margin-top: -100px; position: relative; z-index: 100"
        >
          <div class="d-flex align-items-center gap-3">
            <img
              src="<%= doctor.image %>"
              alt="Doctor Image"
              class="practitioner-avatar border shadow-sm rounded-circle"
              style="width: 75px; height: 75px; object-fit: cover"
            />
            <div class="text-start">
              <div
                class="showcase-badge mb-1"
                style="font-size: 12px; color: #00a8bd"
              >
                <span class="dot-teal me-2"></span> Verified Specialist Profile
              </div>
              <h2 class="fw-bold text-dark mb-0" style="font-size: 24px">
                Dr. <%= doctor.name %>
              </h2>
              <div class="d-flex flex-wrap gap-3 mt-1 text-muted small">
                <span
                  ><i class="fas fa-stethoscope text-info me-1"></i> <%=
                  doctor.field %></span
                >
                <span
                  ><i class="fas fa-envelope text-info me-1"></i> <%=
                  doctor.email %></span
                >
              </div>
            </div>
          </div>
        </div>

        <div class="row g-4 mb-5">
          <div class="col-md-4">
            <div
              class="metric-status-card bg-white border shadow-sm p-4 rounded-5 text-start d-flex align-items-center gap-3"
            >
              <div
                class="metric-icon text-warning rounded-4 d-flex align-items-center justify-content-center"
                style="
                  width: 50px;
                  height: 50px;
                  font-size: 20px;
                  background: rgba(255, 193, 7, 0.08);
                  color: #ffc107 !important;
                "
              >
                <i class="far fa-calendar-check"></i>
              </div>
              <div>
                <h4
                  class="text-muted small fw-medium mb-1"
                  style="font-size: 13px"
                >
                  Clinical Status
                </h4>
                <p class="h5 fw-bold text-dark mb-0">Live Allocations</p>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div
              class="metric-status-card bg-white border shadow-sm p-4 rounded-5 text-start d-flex align-items-center gap-3"
            >
              <div
                class="metric-icon text-success rounded-4 d-flex align-items-center justify-content-center"
                style="
                  width: 50px;
                  height: 50px;
                  font-size: 20px;
                  background: rgba(40, 167, 69, 0.08);
                  color: #28a745 !important;
                "
              >
                <i class="fas fa-wallet"></i>
              </div>
              <div>
                <h4
                  class="text-muted small fw-medium mb-1"
                  style="font-size: 13px"
                >
                  Consultation Fees
                </h4>
                <p class="h5 fw-bold text-dark mb-0">
                  ₹<%= doctor.fees || '0' %>
                </p>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div
              class="metric-status-card bg-white border shadow-sm p-4 rounded-5 text-start d-flex align-items-center gap-3"
            >
              <div
                class="metric-icon text-danger rounded-4 d-flex align-items-center justify-content-center"
                style="
                  width: 50px;
                  height: 50px;
                  font-size: 20px;
                  background: rgba(220, 53, 69, 0.08);
                  color: #dc3545 !important;
                "
              >
                <i class="fas fa-business-time"></i>
              </div>
              <div>
                <h4
                  class="text-muted small fw-medium mb-1"
                  style="font-size: 13px"
                >
                  Experience Block
                </h4>
                <p class="h5 fw-bold text-dark mb-0">
                  <%= doctor.experience || 'N/A' %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-lg-3">
            <div
              class="dashboard-nav bg-white border shadow-sm p-3 rounded-5 d-flex flex-column gap-2 text-start"
            >
              <span class="small text-muted px-3 py-1 uppercase tracking-wider"
                >Navigation Menu</span
              >
              <a
                href="#"
                class="nav-item active"
                onclick="showSection('appointments')"
              >
                <i class="fas fa-calendar-check me-2"></i> Appointments
              </a>
              <a href="#" class="nav-item" onclick="showSection('slots')">
                <i class="fas fa-clock me-2"></i> Manage Slots
              </a>
              <a href="/doctorProfile" class="nav-item">
                <i class="fas fa-user-edit me-2"></i> Profile settings
              </a>
              <a href="/api/doctors/logout" class="nav-item text-danger">
                <i class="fas fa-sign-out-alt me-2"></i> Logout Desk
              </a>
            </div>
          </div>

          <div class="col-lg-9">
            <div
              class="dashboard-content bg-white border shadow-sm p-4 p-md-5 rounded-5 text-start min-height-lock"
            >
              <div id="appointments-section" class="content-section active">
                <h3 class="panel-heading-title mb-4">
                  <i class="fas fa-notes-medical text-info me-2"></i> Your
                  Appointments
                </h3>
                <div
                  id="appointments-list"
                  class="appointments-container d-flex flex-column gap-3"
                ></div>
              </div>

              <div
                id="slots-section"
                class="content-section"
                style="display: none"
              >
                <h3 class="panel-heading-title mb-2">
                  <i class="fas fa-user-clock text-info me-2"></i> Manage Slots
                </h3>
                <p class="small text-muted mb-4">
                  Select custom parameters to filter or update hourly tracking
                  slots metrics safely.
                </p>

                <div
                  class="slot-controls d-flex flex-wrap align-items-center gap-3 p-3 bg-light rounded-4 border mb-4"
                >
                  <label
                    for="slot-date"
                    class="small fw-bold text-secondary mb-0"
                    >Select Date:</label
                  >
                  <input
                    type="date"
                    id="slot-date"
                    class="form-control d-inline-block w-auto"
                    style="border-radius: 8px"
                  />
                  <button
                    onclick="loadSlots()"
                    class="btn btn-theme-solid py-2 px-4"
                    style="font-size: 14px; margin-top: 0"
                  >
                    Load Slots
                  </button>
                </div>

                <div id="slots-list" class="slots-container row g-3"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%- include('./includes/doctorFooter') %>

    <script>
      function showSection(section) {
        document
          .querySelectorAll(".content-section")
          .forEach((s) => (s.style.display = "none"));
        document.getElementById(section + "-section").style.display = "block";
        document
          .querySelectorAll(".nav-item")
          .forEach((n) => n.classList.remove("active"));

        // Dynamic active state switcher supporting anchor triggers accurately
        const targetNav = document.querySelector(
          `.nav-item[onclick="showSection('${section}')"]`,
        );
        if (targetNav) targetNav.classList.add("active");

        if (section === "appointments") {
          loadAppointments();
        } else if (section === "slots") {
          const today = new Date().toISOString().split("T")[0];
          const slotDateInput = document.getElementById("slot-date");
          if (slotDateInput && !slotDateInput.value) {
            slotDateInput.value = today;
          }
          loadSlots();
        }
      }

      async function loadAppointments() {
        try {
          const response = await fetch("/api/doctors/appointments");
          const appointments = await response.json();
          const list = document.getElementById("appointments-list");
          list.innerHTML = "";

          if (appointments.length === 0) {
            list.innerHTML =
              "<div class='p-4 bg-light text-center rounded-4 text-muted'><i class='fas fa-folder-open mb-2 d-block h4'></i>No upcoming appointments found.</div>";
          } else {
            appointments.forEach((apt) => {
              const div = document.createElement("div");
              div.className =
                "appointment-item p-3 border rounded-4 bg-light-split d-flex justify-content-between align-items-center flex-wrap gap-3";
              div.innerHTML = `
                <div class="text-start">
                  <h4 class="fw-bold text-dark h6 mb-2">Appointment with ${apt.user.name}</h4>
                  <p class="small text-muted mb-1"><i class="fas fa-user me-2 text-info"></i><strong>Patient:</strong> ${apt.user.name} (${apt.user.email})</p>
                  <div class="d-flex gap-3 mt-2">
                    <span class="small text-dark" style="font-size:12px;"><i class="far fa-calendar text-info me-1"></i> ${new Date(apt.date).toLocaleDateString()}</span>
                    <span class="small text-dark" style="font-size:12px;"><i class="far fa-clock text-info me-1"></i> ${apt.time}</span>
                  </div>
                </div>
                <span class="badge rounded-pill px-3 py-2 uppercase tracking-wider status-pill-${apt.status.toLowerCase()}" style="font-size:11px; font-weight:700;">${apt.status}</span>
              `;
              list.appendChild(div);
            });
          }
        } catch (error) {
          console.error("Error loading appointments:", error);
          document.getElementById("appointments-list").innerHTML =
            "<div class='p-3 text-danger text-center bg-light rounded-3'>Failed to load appointments registry logs.</div>";
        }
      }

      async function loadSlots() {
        const date = document.getElementById("slot-date").value;
        if (!date) {
          alert("Please select a date");
          return;
        }

        try {
          const slotsResponse = await fetch(`/api/doctors/slots?date=${date}`);
          if (!slotsResponse.ok) {
            throw new Error(
              "Failed to fetch slots. You might need to be logged in.",
            );
          }

          const slots = await slotsResponse.json();
          const list = document.getElementById("slots-list");
          list.innerHTML = "";

          if (slots.length === 0) {
            list.innerHTML =
              "<div class='col-12'><div class='p-4 bg-light text-center rounded-4 text-muted'>No slots generated for this date. They will be created upon user booking attempt.</div></div>";
            return;
          }

          slots.forEach((slot) => {
            const colNode = document.createElement("div");
            colNode.className = "col-md-6 col-xl-4";

            let slotStatusText = "Available";
            let actionBtnHtml = "";
            let utilityCardClass =
              "bg-white border rounded-4 p-3 d-flex flex-column gap-2 h-100 slot-card-runtime";

            if (slot.available === false) {
              slotStatusText = "Unavailable";
              utilityCardClass += " slot-disabled-bg";
              actionBtnHtml = `<button onclick="toggleAvailability('${slot._id}', true)" class="btn btn-sm btn-success w-100 rounded-3">Make Available</button>`;
            } else {
              actionBtnHtml = `<button onclick="toggleAvailability('${slot._id}', false)" class="btn btn-sm btn-outline-danger w-100 rounded-3">Make Unavailable</button>`;
            }

            colNode.innerHTML = `
              <div class="${utilityCardClass}">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="small text-dark fw-bold"><i class="fas fa-clock text-info me-1"></i> ${slot.time}</span>
                  <span class="badge-status-dot dot-${slotStatusText.toLowerCase()}">${slotStatusText}</span>
                </div>
                <div class="d-flex flex-column gap-2 mt-2 pt-2 border-top">
                  ${actionBtnHtml}
                  <button onclick="editTime('${slot._id}', '${slot.time}')" class="btn btn-sm btn-light border w-100 text-secondary rounded-3">
                    <i class="fas fa-edit me-1"></i> Edit Time
                  </button>
                </div>
              </div>
            `;
            list.appendChild(colNode);
          });
        } catch (error) {
          console.error("Error loading slots:", error);
          document.getElementById("slots-list").innerHTML =
            `<div class='col-12'><p class='alert alert-danger'>${error.message}</p></div>`;
        }
      }

      async function toggleAvailability(slotId, available) {
        try {
          const response = await fetch(
            `/api/doctors/slots/${slotId}/availability`,
            {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ available }),
            },
          );
          const result = await response.json();
          if (response.ok) {
            loadSlots();
          } else {
            alert("Error updating slot: " + result.message);
          }
        } catch (error) {
          console.error("Error toggling availability:", error);
        }
      }

      async function editTime(slotId, currentTime) {
        const newTime = prompt(
          "Enter new time (HH:MM format, e.g., 14:30):",
          currentTime,
        );
        if (!newTime || newTime === currentTime) return;

        const timeRegex = /^([01]?[0-9]|2[0-3]):[0-5][0-9]$/;
        if (!timeRegex.test(newTime)) {
          alert("Please enter a valid time in HH:MM format.");
          return;
        }

        try {
          const response = await fetch(`/api/doctors/slots/${slotId}/time`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ time: newTime }),
          });
          const result = await response.json();
          if (response.ok) {
            loadSlots();
          } else {
            alert("Error updating slot time: " + result.message);
          }
        } catch (error) {
          console.error("Error editing time:", error);
        }
      }

      document.addEventListener("DOMContentLoaded", () => {
        showSection("appointments");
      });
    </script>
  </body>
</html>
