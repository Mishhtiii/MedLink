<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link href="/styles/reset.css" rel="stylesheet" />
    <link href="/styles/navbar.css" rel="stylesheet" />
    <link href="/styles/doctorProfile.css" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include('includes/doctorHeader') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content text-start">
          <div class="hero-badge-panel mb-3">
            <span class="dot-teal me-2"></span> Practitioner Credentials
            Terminal
          </div>
          <h1 class="hero-title text-white">
            Manage &amp; View <br />
            Your Professional <br />
            Practitioner File
          </h1>
          <p class="hero-text">
            Review your dynamic clinical specialization parameters, official
            registered contact channels, academic qualifications records, and
            client ranking data indexes seamlessly.
          </p>
        </div>
      </div>
    </section>

    <section class="profile-dashboard-wrapper py-5">
      <div class="container">
        <div
          class="profile-user-header-card bg-white border shadow-sm p-4 rounded-5 mb-4 text-start d-flex align-items-center gap-4"
          style="margin-top: -100px; position: relative; z-index: 100"
        >
          <div
            class="profile-avatar-circle shadow-sm border rounded-circle d-flex align-items-center justify-content-center text-info bg-light-teal"
            style="
              width: 75px;
              height: 75px;
              font-size: 28px;
              background-color: rgba(0, 168, 189, 0.07);
              color: #00a8bd !important;
            "
          >
            <i class="fas fa-user-md"></i>
          </div>
          <div>
            <div
              class="showcase-badge mb-1"
              style="font-size: 12px; color: #00a8bd"
            >
              <span class="dot-teal me-2"></span> Active Consultant File
            </div>
            <h2
              id="doctor-name"
              class="fw-bold text-dark mb-1"
              style="font-size: 24px"
            >
              Loading...
            </h2>
            <p
              id="doctor-speciality"
              class="small text-muted mb-0 font-monospace"
            >
              Loading...
            </p>
          </div>
        </div>

        <div
          class="card profile-meta-card bg-white border shadow-sm p-4 p-md-5 rounded-5 text-start mb-4"
        >
          <h3
            class="card-heading-title mb-4 pb-2 border-bottom"
            style="font-size: 20px; font-weight: 700; color: #072331"
          >
            <i
              class="fas fa-id-card-clip text-info me-2"
              style="color: #00a8bd !important"
            ></i>
            Professional Information
          </h3>

          <div class="row g-3 info-profile-lines">
            <div class="col-md-6 border-bottom pb-3">
              <p class="mb-0 text-secondary small fw-medium">Full Name Title</p>
              <strong id="info-name" class="text-dark d-block mt-1"
                >Loading...</strong
              >
            </div>
            <div class="col-md-6 border-bottom pb-3">
              <p class="mb-0 text-secondary small fw-medium">
                Practitioner Username
              </p>
              <strong id="info-username" class="text-dark d-block mt-1"
                >Loading...</strong
              >
            </div>
            <div class="col-md-6 border-bottom pb-3">
              <p class="mb-0 text-secondary small fw-medium">
                Official Email Address
              </p>
              <strong id="info-email" class="text-dark d-block mt-1"
                >Loading...</strong
              >
            </div>
            <div class="col-md-6 border-bottom pb-3">
              <p class="mb-0 text-secondary small fw-medium">
                Assigned Speciality Domain
              </p>
              <strong id="info-field" class="text-dark d-block mt-1"
                >Loading...</strong
              >
            </div>
            <div class="col-md-6 border-bottom pb-3">
              <p class="mb-0 text-secondary small fw-medium">
                Academic Qualifications
              </p>
              <strong id="info-qualification" class="text-dark d-block mt-1"
                >Loading...</strong
              >
            </div>
            <div class="col-md-6 border-bottom pb-3">
              <p class="mb-0 text-secondary small fw-medium">
                Practice Experience Span
              </p>
              <strong id="info-experience" class="text-dark d-block mt-1"
                >Loading...</strong
              >
            </div>
            <div class="col-md-6 border-bottom pb-3">
              <p class="mb-0 text-secondary small fw-medium">
                Operational Location / City
              </p>
              <strong id="info-location" class="text-dark d-block mt-1"
                >Loading...</strong
              >
            </div>
            <div class="col-md-6 border-bottom pb-3">
              <p class="mb-0 text-secondary small fw-medium">
                Public Feedback Rating
              </p>
              <div class="d-flex align-items-center gap-1 mt-1">
                <i
                  class="fas fa-star text-warning"
                  style="color: #ffc107 !important"
                ></i>
                <strong id="info-rating" class="text-dark">Loading...</strong>
                <span class="text-muted small">/ 5 Rating nodes</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      async function fetchDoctorInfo() {
        try {
          const response = await fetch("/api/doctors/profile-data");

          if (response.status === 401) {
            window.location.href = "/doctorLogin";
            return;
          }

          if (!response.ok) throw new Error("Network response was not ok");
          const data = await response.json();
          if (data.doctor) {
            document.getElementById("doctor-name").textContent =
              data.doctor.name || "N/A";
            document.getElementById("doctor-speciality").textContent =
              data.doctor.field || "N/A";
            document.getElementById("info-name").textContent =
              data.doctor.name || "N/A";
            document.getElementById("info-username").textContent =
              data.doctor.username || "N/A";
            document.getElementById("info-email").textContent =
              data.doctor.email || "N/A";
            document.getElementById("info-field").textContent =
              data.doctor.field || "N/A";
            document.getElementById("info-qualification").textContent =
              data.doctor.qualification || "N/A";
            document.getElementById("info-experience").textContent =
              data.doctor.experience || "N/A";
            document.getElementById("info-location").textContent =
              data.doctor.location || "Not specified";
            document.getElementById("info-rating").textContent =
              data.doctor.rating || "N/A";
          } else {
            document.getElementById("doctor-name").textContent =
              "Doctor not found";
            document.getElementById("doctor-speciality").textContent = "N/A";
            document.getElementById("info-name").textContent = "N/A";
            document.getElementById("info-username").textContent = "N/A";
            document.getElementById("info-email").textContent = "N/A";
            document.getElementById("info-field").textContent = "N/A";
            document.getElementById("info-qualification").textContent = "N/A";
            document.getElementById("info-experience").textContent = "N/A";
            document.getElementById("info-location").textContent =
              "Not specified";
            document.getElementById("info-rating").textContent = "N/A";
          }
        } catch (error) {
          console.error("Failed to fetch doctor info:", error);
          document.getElementById("doctor-name").textContent =
            "Error loading doctor info";
          document.getElementById("doctor-speciality").textContent = "Error";
          document.getElementById("info-name").textContent = "Error";
          document.getElementById("info-username").textContent = "Error";
          document.getElementById("info-email").textContent = "Error";
          document.getElementById("info-field").textContent = "Error";
          document.getElementById("info-qualification").textContent = "Error";
          document.getElementById("info-experience").textContent = "Error";
          document.getElementById("info-location").textContent = "Error";
          document.getElementById("info-rating").textContent = "Error";
        }
      }

      fetchDoctorInfo();
    </script>

    <%- include('includes/doctorFooter') %>
  </body>
</html>
