<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/orderByPrescription.css" />
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Digital Prescription Desk</div>
          <h1 class="hero-title text-white">
            Upload Prescription <br />
            & Get Medicines <br />
            Delivered Fast
          </h1>
          <p class="hero-text">
            Skip the queue by sharing a verified copy of your medical
            prescription sheet. Our digital pharmacist network will instantly
            review your required dosage items and dispatch them safely straight
            to your door.
          </p>
        </div>
      </div>
    </section>

    <section class="order-prescription-section py-5">
      <div class="container">
        <div
          class="upload-card-wrapper shadow-sm border p-4 p-md-5 bg-white rounded-5"
        >
          <div class="section-title-block text-center mb-5">
            <div class="showcase-badge mb-2">
              <span class="dot-teal me-2"></span> Secure Verification
            </div>
            <h2 class="form-main-heading">Order by Prescription</h2>
            <p class="text-muted small mb-0">
              Please upload a valid scan copy or PDF document of your
              prescription to order medicines.
            </p>
          </div>

          <form
            id="prescription-form"
            action="/submit-prescription"
            method="POST"
            enctype="multipart/form-data"
            class="d-flex flex-column gap-4 align-items-center"
          >
            <div class="prescription-drop-zone-wrapper w-100 position-relative">
              <input
                type="file"
                id="prescription-file"
                name="prescription"
                accept="image/*,application/pdf"
                required
                class="hidden-file-input"
              />
              <div
                class="drop-zone-overlay-ui d-flex flex-column align-items-center justify-content-center p-5 rounded-4 text-center"
              >
                <div class="upload-icon-circle mb-3 shadow-sm border">
                  <i class="fas fa-cloud-arrow-up text-info"></i>
                </div>
                <h5 class="fw-bold text-dark h6 mb-2" id="file-status-text">
                  Drag and drop or browse files
                </h5>
                <p class="small text-muted mb-0">
                  Supports high-res scanned images (JPG, PNG) or application PDF
                  files.
                </p>
              </div>
            </div>

            <button type="submit" class="btn-prescription-submit-action mt-3">
              Submit Prescription
              <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
            </button>
          </form>
        </div>
      </div>
    </section>

    <script>
      const fileInput = document.getElementById("prescription-file");
      const statusText = document.getElementById("file-status-text");
      const dropZone = document.querySelector(".drop-zone-overlay-ui");

      fileInput.addEventListener("change", (e) => {
        if (e.target.files.length > 0) {
          statusText.innerHTML = `<i class="fas fa-file-circle-check text-success me-2"></i> Ready: ${e.target.files[0].name}`;
          dropZone.style.borderColor = "var(--teal-color)";
          dropZone.style.backgroundColor = "#f4fcfd";
        }
      });
    </script>

    <%- include('includes/footer') %>
  </body>
</html>
