<!DOCTYPE html>
<html>
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css"
    />
    <link href="styles/findHospital.css" rel="stylesheet" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Real-time Location Services</div>
          <h1 class="hero-title text-white">
            Find The Nearest <br />
            Verified Medical <br />
            Institutions
          </h1>
          <p class="hero-text">
            Welcome to MedLink geofencing maps. Locate the best hospitals,
            trauma centers, and specialist clinics in your area in case of
            routine checkups or immediate emergencies.
          </p>
        </div>

        <div class="hero-search-wrapper-box mt-5">
          <div
            id="searchBar"
            class="d-flex align-items-center gap-2 bg-white p-3 rounded-4 shadow-lg"
          >
            <div class="input-icon-group flex-grow-1 position-relative">
              <i
                id="loc"
                class="fas fa-map-marker-alt text-info position-absolute"
                style="
                  left: 20px;
                  top: 50%;
                  transform: translateY(-50%);
                  font-size: 18px;
                "
              ></i>
              <input
                type="text"
                id="citySearch"
                class="form-control-custom"
                placeholder="Enter current city, region, or zip code..."
              />
            </div>
            <button onclick="searchCity()" class="btn-search-trigger">
              <i class="fas fa-search me-2"></i> Find Now
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="map-visualization-section py-5">
      <div class="container">
        <div class="d-flex flex-column align-items-start text-start mb-4">
          <div class="showcase-badge mb-2">
            <span class="dot-teal me-2"></span> GIS Mapping Engine
          </div>
          <h2 class="section-main-heading">Live Interactive Trackers</h2>
        </div>

        <div class="row g-4">
          <div class="col-lg-8">
            <div
              id="map"
              class="shadow-sm border rounded-5 overflow-hidden"
            ></div>
          </div>

          <div class="col-lg-4">
            <div class="hospital-sidebar-card">
              <div class="hospital-sidebar-header">
                <h5
                  class="fw-bold mb-0"
                  style="font-size: 15px; letter-spacing: 0.3px"
                >
                  <i
                    class="fas fa-hospital-user me-2"
                    style="color: var(--teal-color)"
                  ></i>
                  Detected Medical Facilities
                </h5>
              </div>
              <div id="hospitalList"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%- include('includes/footer') %>
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
    <script src="js/findHospital.js"></script>
  </body>
</html>
