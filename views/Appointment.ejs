<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/Appointment.css" rel="stylesheet" />
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Scheduling Desk</div>
          <h1 class="hero-title text-white">
            Book Your Next <br />
            Medical Consultation <br />
            Seamlessly
          </h1>
          <p class="hero-text">
            Secure your preferred time slot with verified medical specialists. 
            Our automated configuration systems lock your calendar reservation instantly for either physical visits or remote tele-health channels.
          </p>
        </div>
      </div>
    </section>

    <section class="appointment-form-section py-5">
      <div class="container bg-white shadow-sm border rounded-5 p-4 p-lg-5" style="margin-top: -40px; position: relative; z-index: 10; max-width: 700px;">
        <div class="form-container">
          
          <div class="about-badge mb-3">
            <span class="dot-teal me-2"></span> Calendar Allocation
          </div>
          <h2 class="form-main-title mb-2">Schedule Session</h2>
          <p class="text-muted small mb-4">Provide accurate slots parameters below to commit your consultation request onto the server registers.</p>

          <form id="appointmentForm" class="contact-form d-flex flex-column gap-3">
            
            <div class="form-group-custom position-relative">
              <label for="name" class="form-label-text">Full Name</label>
              <div class="position-relative">
                <i class="fas fa-user input-inside-icon"></i>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  class="form-input-control" 
                  placeholder="Enter your full name" 
                  required 
                />
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="phone" class="form-label-text">Contact Number</label>
              <div class="position-relative">
                <i class="fas fa-phone input-inside-icon"></i>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="form-input-control" 
                  placeholder="Enter your phone number" 
                  required 
                />
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="speciality" class="form-label-text">Select Speciality</label>
              <div class="position-relative">
                <i class="fas fa-stethoscope input-inside-icon"></i>
                <select id="speciality" name="speciality" class="form-input-control select-arrow-pad" required>
                  <option value="">Choose a speciality...</option>
                  <option value="Cardiologist">Cardiologist</option>
                  <option value="Dermatologist">Dermatologist</option>
                  <option value="General Physician">General Physician</option>
                  <option value="Neurologist">Neurologist</option>
                  <option value="Pediatrician">Pediatrician</option>
                </select>
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="doctor" class="form-label-text">Select Practitioner</label>
              <div class="position-relative">
                <i class="fas fa-user-md input-inside-icon"></i>
                <select id="doctor" name="doctor" class="form-input-control select-arrow-pad" required>
                  <option value="">Choose a specialist...</option>
                </select>
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="date" class="form-label-text">Consultation Date</label>
              <div class="position-relative">
                <i class="fas fa-calendar-day input-inside-icon"></i>
                <input 
                  type="date" 
                  id="date" 
                  name="date" 
                  class="form-input-control date-picker-pad" 
                  required 
                />
              </div>
            </div>

            <div class="form-group-custom position-relative">
              <label for="time" class="form-label-text">Preferred Time Slot</label>
              <div class="position-relative">
                <i class="fas fa-clock input-inside-icon"></i>
                <select id="time" name="time" class="form-input-control select-arrow-pad" required>
                  <option value="">Choose an available hour...</option>
                  <option value="09:00 AM - 10:00 AM">09:00 AM - 10:00 AM</option>
                  <option value="10:00 AM - 11:00 AM">10:00 AM - 11:00 AM</option>
                  <option value="11:00 AM - 12:00 PM">11:00 AM - 12:00 PM</option>
                  <option value="02:00 PM - 03:00 PM">02:00 PM - 03:00 PM</option>
                  <option value="03:00 PM - 04:00 PM">03:00 PM - 04:00 PM</option>
                  <option value="04:00 PM - 05:00 PM">04:00 PM - 05:00 PM</option>
                </select>
              </div>
            </div>

            <div class="form-group-custom mt-4">
              <button type="submit" class="btn-submit-action w-100">
                Confirm Booking Slot
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </button>
            </div>
          </form>

        </div>
      </div>
    </section>

    <script src="js/home1.js"></script>
    <%- include('includes/footer') %> 

    <script>
      // Populate doctors collection asynchronously based on dynamic speciality value changes
      document.getElementById("speciality").addEventListener("change", function () {
        const speciality = this.value;
        const doctorSelect = document.getElementById("doctor");

        doctorSelect.innerHTML = '<option value="">Choose a specialist...</option>';

        if (speciality) {
          fetch(`/api/doctors/speciality/${speciality}`)
            .then((response) => response.json())
            .then((doctors) => {
              doctors.forEach((doctor) => {
                const option = document.createElement("option");
                option.value = doctor._id;
                option.textContent = doctor.name;
                doctorSelect.appendChild(option);
              });
            })
            .catch((error) => console.error("Error loading doctors payload:", error));
        }
      });

      // Secure payment payload interceptor data submission mechanism
      document.getElementById("appointmentForm").addEventListener("submit", function (e) {
        e.preventDefault();

        // Catching values from all required fields to sync with network payloads
        const name = document.getElementById("name").value;
        const phone = document.getElementById("phone").value;
        const doctor = document.getElementById("doctor").value;
        const date = document.getElementById("date").value;
        const time = document.getElementById("time").value;

        const data = { name, phone, doctor, date, time };

        fetch("/Appointment", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.message === "Appointment booked successfully") {
              alert("Appointment booked successfully!");
              window.location.href = "/";
            } else {
              alert("Error: " + (data.message || "Unknown error parsing request tokens"));
            }
          })
          .catch((error) => {
            console.error("Error submitting appointment structure:", error);
            alert("An error occurred while booking the appointment.");
          });
      });
    </script>

    <% if (typeof selectedDoctor !== 'undefined' && selectedDoctor) { %>
    <script>
      window.addEventListener('DOMContentLoaded', function() {
        const doctorSelect = document.getElementById("doctor");
        const specialitySelect = document.getElementById("speciality");

        // Set speciality based on selected doctor parameters
        specialitySelect.value = "<%= selectedDoctor.field %>";

        // Trigger chain event to populate list rows asynchronously
        specialitySelect.dispatchEvent(new Event('change'));

        // Delay instantiation payload mapping until loop finishes loading elements
        setTimeout(() => {
          doctorSelect.value = "<%= selectedDoctor._id %>";
          doctorSelect.dispatchEvent(new Event('change'));
        }, 500);
      });
    </script>
    <% } %>
  </body>
</html>