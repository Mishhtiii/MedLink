<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/profile.css" rel="stylesheet" />
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Patient Workspace Terminal</div>
          <h1 class="hero-title text-white">
            Manage Your <br />
            Medical History & <br />
            Personal Dashboard
          </h1>
          <p class="hero-text">
            Track your confirmed appointments with medical specialists, monitor
            processed prescription logistics billing history, and update
            configuration credentials securely.
          </p>
        </div>
      </div>
    </section>

    <section class="profile-dashboard-wrapper py-5">
      <div class="container">
        <div
          class="profile-user-header-card bg-white border shadow-sm p-4 rounded-5 mb-4 text-start d-flex align-items-center gap-4"
        >
          <div
            class="profile-avatar-circle shadow-sm border rounded-circle d-flex align-items-center justify-content-center text-info bg-light-teal"
          >
            <i class="fas fa-user-shield"></i>
          </div>
          <div>
            <div class="showcase-badge mb-1">
              <span class="dot-teal me-2"></span> Active Patient File
            </div>
            <h2 id="user-name" class="fw-bold text-dark mb-0">Loading...</h2>
          </div>
        </div>

        <div class="row g-4 mb-4">
          <div class="col-lg-6">
            <div
              class="profile-meta-card bg-white border shadow-sm p-4 p-md-5 rounded-5 height-lock text-start"
            >
              <h3 class="card-heading-title mb-4">
                <i class="far fa-calendar-check text-info me-2"></i> My
                Appointments
              </h3>
              <ul
                id="appointments-list"
                class="list-unstyled custom-data-feed-list mb-0"
              >
                <li class="p-3 text-muted bg-light rounded-3 text-center">
                  No appointments to show.
                </li>
              </ul>
            </div>
          </div>

          <div class="col-lg-6">
            <div
              class="profile-meta-card bg-white border shadow-sm p-4 p-md-5 rounded-5 height-lock text-start"
            >
              <h3 class="card-heading-title mb-4">
                <i class="far fa-id-card text-info me-2"></i> General Info
              </h3>
              <div class="d-flex flex-column gap-3 info-profile-lines">
                <p class="mb-0 border-bottom pb-2">
                  <strong>Name:</strong>
                  <span id="info-name" class="text-secondary ms-1"
                    >Loading...</span
                  >
                </p>
                <p class="mb-0 border-bottom pb-2">
                  <strong>Username:</strong>
                  <span id="info-username" class="text-secondary ms-1"
                    >Loading...</span
                  >
                </p>
                <p class="mb-0 border-bottom pb-2">
                  <strong>Email Address:</strong>
                  <span id="info-email" class="text-secondary ms-1"
                    >Loading...</span
                  >
                </p>
              </div>
            </div>
          </div>
        </div>

        <div
          class="medicines-history-section bg-white border shadow-sm p-4 p-md-5 rounded-5 text-start"
        >
          <div
            class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 pb-3 border-bottom"
          >
            <div>
              <h3 class="card-heading-title mb-1">
                <i
                  class="fas fa-prescription-bottle-medical text-info me-2"
                ></i>
                Purchased Medicines
              </h3>
              <p class="small text-muted mb-0">
                History log records of your digital pharmaceutical transactions.
              </p>
            </div>
            <button id="clear-medicines-btn" class="btn-clear-history-action">
              <i class="fas fa-trash-can me-2"></i> Clear All Medicines
            </button>
          </div>

          <div id="medicines-list" class="row g-3">
            <div class="col-11 text-center py-4">
              <div class="no-medicines text-muted bg-light rounded-4 p-4">
                No medicines purchased yet.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      async function fetchUserInfo() {
        try {
          const response = await fetch("/api/users/profile", {
            credentials: "include",
          });
          if (!response.ok) throw new Error("Network response was not ok");
          const data = await response.json();
          if (data.user) {
            document.getElementById("user-name").textContent =
              data.user.name || "N/A";

            document.getElementById("info-name").textContent =
              data.user.name || "N/A";
            document.getElementById("info-username").textContent =
              data.user.username || "N/A";
            document.getElementById("info-email").textContent =
              data.user.email || "N/A";

            // Display purchased medicines
            const medicinesList = document.getElementById("medicines-list");
            if (
              data.user.purchasedMedicines &&
              data.user.purchasedMedicines.length > 0
            ) {
              medicinesList.innerHTML = "";
              data.user.purchasedMedicines.forEach((medicine) => {
                const colNode = document.createElement("div");
                colNode.className = "col-md-6 col-lg-4";
                colNode.innerHTML = `
                  <div class="js-medicine-card d-flex align-items-center gap-3 p-3 border rounded-4 bg-white h-100">
                    <img src="${medicine.image}" alt="${medicine.name}" class="medicine-image-thumbnail">
                    <div class="medicine-details-text text-start">
                      <h4 class="fw-bold text-dark h6 mb-1">${medicine.name}</h4>
                      <p class="small text-muted mb-1">Quantity: ${medicine.quantity}</p>
                      <p class="small text-teal fw-bold mb-1">Price: ₹${medicine.price}</p>
                      <p class="small text-muted mb-0" style="font-size: 11px;">Date: ${new Date(medicine.date).toLocaleDateString()}</p>
                    </div>
                  </div>
                `;
                medicinesList.appendChild(colNode);
              });
            } else {
              medicinesList.innerHTML =
                '<div class="col-12"><div class="no-medicines text-muted bg-light rounded-4 p-4 text-center">No medicines purchased yet.</div></div>';
            }
          } else {
            document.getElementById("user-name").textContent = "Guest";
            document.getElementById("info-name").textContent = "N/A";
            document.getElementById("info-username").textContent = "N/A";
            document.getElementById("info-email").textContent = "N/A";
            document.getElementById("medicines-list").innerHTML =
              '<div class="col-12"><div class="no-medicines text-muted bg-light rounded-4 p-4 text-center">No medicines purchased yet.</div></div>';
          }
        } catch (error) {
          console.error("Failed to fetch user info:", error);
          document.getElementById("user-name").textContent =
            "Error loading user info";
          document.getElementById("info-name").textContent = "Error";
          document.getElementById("info-username").textContent = "Error";
          document.getElementById("info-email").textContent = "Error";
          document.getElementById("medicines-list").innerHTML =
            '<div class="col-12"><div class="no-medicines text-danger bg-light rounded-4 p-4 text-center">Error loading medicines.</div></div>';
        }
      }

      // Clear all medicines button confirmation hook
      document
        .getElementById("clear-medicines-btn")
        .addEventListener("click", async () => {
          if (
            confirm("Are you sure you want to clear all purchased medicines?")
          ) {
            try {
              const response = await fetch("/api/users/clear-medicines", {
                method: "DELETE",
              });
              if (response.ok) {
                alert("All medicines cleared successfully!");
                fetchUserInfo(); // Refresh the profile logs
              } else {
                alert("Failed to clear medicines.");
              }
            } catch (error) {
              console.error("Error clearing medicines:", error);
              alert("Error clearing medicines.");
            }
          }
        });

      async function fetchUserAppointments() {
        try {
          const response = await fetch("/api/users/appointments", {
            credentials: "include",
          });
          if (!response.ok) throw new Error("Network response was not ok");
          const appointments = await response.json();
          const appointmentsList = document.getElementById("appointments-list");
          if (appointments.length > 0) {
            appointmentsList.innerHTML = "";
            appointments.forEach((appointment) => {
              const li = document.createElement("div");
              li.className =
                "appointment-node-item border p-3 rounded-4 mb-2 bg-light-split";
              li.innerHTML = `
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="fw-bold text-dark mb-0 h6">${appointment.doctor.name}</h5>
                  <span class="badge-status-pill status-${appointment.status.toLowerCase()}">${appointment.status}</span>
                </div>
                <p class="small text-muted mb-1"><i class="fas fa-stethoscope me-1"></i> Field: ${appointment.doctor.field}</p>
                <div class="d-flex gap-3 mt-2 pt-2 border-top border-light-sub">
                  <span class="small text-dark" style="font-size: 12px;"><i class="far fa-calendar me-1 text-info"></i> ${new Date(appointment.date).toLocaleDateString()}</span>
                  <span class="small text-dark" style="font-size: 12px;"><i class="far fa-clock me-1 text-info"></i> ${appointment.time}</span>
                </div>
              `;
              appointmentsList.appendChild(li);
            });
          } else {
            appointmentsList.innerHTML =
              '<div class="p-3 text-muted bg-light rounded-3 text-center">No appointments to show.</div>';
          }
        } catch (error) {
          console.error("Failed to fetch appointments:", error);
          document.getElementById("appointments-list").innerHTML =
            '<div class="p-3 text-danger bg-light rounded-3 text-center">Error loading appointments.</div>';
        }
      }

      fetchUserInfo();
      fetchUserAppointments();
    </script>

    <%- include('includes/footer') %>
  </body>
</html>
