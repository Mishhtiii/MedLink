<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/shine.css" rel="stylesheet" />
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Verified Specialists Database</div>
          <h1 class="hero-title text-white">
            Search For Top <br />
            Medical Experts & <br />
            Book Appointments
          </h1>
          <p class="hero-text">
            Connect instantly with highly-qualified multi-speciality medical practitioners. 
            Filter through certifications, real-time reviews, and secure your optimal time slot in seconds.
          </p>
        </div>
      </div>
    </section>

    <section class="results-section py-5">
      <div class="container">
        <div class="row g-4">
          
          <div class="col-lg-4">
            <form class="filter-sidebar-card shadow-sm border p-4 bg-white rounded-5 text-start" method="GET" action="/finddoctor">
              <div class="about-badge mb-3">
                <span class="dot-teal me-2"></span> Search Filters
              </div>
              <h2 class="filter-title mb-4">Refine Your Search</h2>
              
              <div class="form-group-custom mb-3 position-relative">
                <label class="form-label-text">Keyword Match</label>
                <div class="position-relative">
                  <i class="fas fa-magnifying-glass input-inside-icon"></i>
                  <input
                    type="text"
                    name="search"
                    class="form-input-control"
                    placeholder="Doctor name or keyword..."
                    value="<%= typeof req.query.search !== 'undefined' ? req.query.search : '' %>"
                  />
                </div>
              </div>

              <div class="form-group-custom mb-3">
                <label class="form-label-text">Medical Domain</label>
                <select name="speciality" class="form-input-control select-arrow-pad">
                  <option value="">All Specialities</option>
                  <% (Array.isArray(specialities) ? specialities : []).forEach(s => { %>
                  <option value="<%= s.name %>" <%= req.query.speciality === s.name ? 'selected' : '' %>><%= s.name %></option>
                  <% }); %>
                </select>
              </div>

              <div class="form-group-custom mb-4">
                <label class="form-label-text">Qualification Grade</label>
                <select name="qualification" class="form-input-control select-arrow-pad">
                  <option value="">All Qualifications</option>
                  <% ["MBBS", "MBBch", "MD", "DO"].forEach(q => { %>
                  <option value="<%= q %>" <%= req.query.qualification === q ? 'selected' : '' %>><%= q %></option>
                  <% }) %>
                </select>
              </div>

              <button type="submit" class="btn-update-search-action w-100">
                Update Search <i class="fas fa-arrows-rotate ms-2 rotate-arrow"></i>
              </button>
            </form>
          </div>

          <div class="col-lg-8">
            <div class="doctor-feed-wrapper">
              <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 text-start">
                <div>
                  <div class="showcase-badge mb-1"><span class="dot-teal me-2"></span> Available Personnel</div>
                  <h3 class="fw-bold mb-0 text-dark h5">Verified Practitioners Matching Query</h3>
                </div>
                <div class="sort-dropdown-box">
                  <select class="form-input-control py-2 select-arrow-pad bg-white shadow-sm" style="min-width: 200px; font-size: 13px;">
                    <option value="highest">Sort by: Highest Rated</option>
                  </select>
                </div>
              </div>

              <div class="row g-3">
                <% (Array.isArray(doctors) ? doctors : []).forEach(d => { %>
                <div class="col-md-6">
                  <div class="doctor-profile-card border shadow-sm bg-white rounded-4 p-4 text-start position-relative" tabindex="0">
                    
                    <div class="d-flex align-items-center gap-3 mb-3">
                      <div class="doctor-avatar-box shadow-sm border rounded-circle overflow-hidden">
                        <img src="/images/<%= d.img %>" alt="<%= d.name %>" onerror="this.src='https://i.pravatar.cc/150?img=60'" />
                      </div>
                      <div>
                        <h4 class="doctor-name-heading mb-1"><%= d.name %></h4>
                        <span class="badge bg-light-teal text-teal font-weight-600 px-3 py-1 rounded-pill small-field-tag">
                          <%= d.field %>
                        </span>
                      </div>
                    </div>

                    <div class="doctor-details-collapsible-zone border-top border-bottom py-3 my-3">
                      <div class="d-flex justify-content-between align-items-center detail-click-toggle" style="cursor: pointer;">
                        <span class="small text-muted font-weight-500"><i class="far fa-id-badge me-1"></i> View Profile Track</span>
                        <i class="fas fa-chevron-down detail-arrow-icon text-muted" style="transition: transform 0.3s;"></i>
                      </div>
                      
                      <div class="doctor-details-drawer mt-3" style="display: none;">
                        <div class="d-flex flex-column gap-2">
                          <div class="small text-dark"><strong class="text-secondary">Experience:</strong> <%= d.experience %> Years</div>
                          <div class="small text-dark"><strong class="text-secondary">Degree:</strong> <%= d.qualification %></div>
                          <div class="small text-dark"><strong class="text-secondary">Coordinates:</strong> <i class="fas fa-location-dot text-info ms-1"></i> <%= d.location || 'Not specified' %></div>
                          <div class="small text-dark"><strong class="text-secondary">Patient Rating:</strong> <i class="fas fa-star text-warning ms-1"></i> <%= d.rating %> / 5.0</div>
                        </div>
                      </div>
                    </div>

                    <button
                      onclick="event.stopPropagation(); window.location.href='/Appointment?doctorId=<%= d._id %>'"
                      class="btn-book-appointment-action w-100"
                    >
                      Book Appointment <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
                    </button>
                    
                  </div>
                </div>
                <% }) %>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <script src="/js/home1.js"></script>
    <script>
      // Toggle dynamic custom interactive drawers cleanly
      document.querySelectorAll(".doctor-profile-card").forEach((card) => {
        const toggleHeader = card.querySelector(".detail-click-toggle");
        const drawer = card.querySelector(".doctor-details-drawer");
        const arrow = card.querySelector(".detail-arrow-icon");

        toggleHeader.addEventListener("click", (e) => {
          e.stopPropagation();
          if (drawer.style.display === "none" || drawer.style.display === "") {
            drawer.style.display = "block";
            arrow.style.transform = "rotate(180deg)";
          } else {
            drawer.style.display = "none";
            arrow.style.transform = "rotate(0deg)";
          }
        });
      });
    </script>

    <%- include('includes/footer') %>
  </body>
</html>