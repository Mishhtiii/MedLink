<!doctype html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/Services.css" rel="stylesheet" />
  </head>

  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Our Medical Expertise</div>
          <h1 class="hero-title text-white">
            Comprehensive <br />
            Healthcare Services <br />
            For Everyone
          </h1>
          <p class="hero-text">
            Explore our wide range of professional medical services optimized
            for your well-being. From instant digital prescriptions and hospital
            mapping to emergency call support, we ensure seamless health
            management.
          </p>
        </div>
      </div>
    </section>

    <section class="services-section py-5">
      <div class="container text-center">
        <div class="services-badge mb-3">
          <span class="dot-teal me-2"></span> Medical Solutions
        </div>
        <h2 class="services-main-title mb-5">
          Expert healthcare facilities designed <br />
          for smooth living
        </h2>

        <div class="row g-4 justify-content-center">
          <div class="col-lg-4 col-md-6">
            <div
              class="service-card"
              onclick="window.location.href = '/finddoctor'"
            >
              <div class="service-card-top">
                <div class="service-icon"><i class="fas fa-user-md"></i></div>
                <h3 class="fw-bold h5">Find Specialists</h3>
                <p class="small text-muted">
                  Browse verified multi-speciality doctors, check real-time
                  availability, and connect with experts instantly.
                </p>
              </div>
              <a href="/finddoctor" class="view-details-btn">
                Find Doctor
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-4 col-md-6">
            <div
              class="service-card"
              onclick="window.location.href = '/pharmacy'"
            >
              <div class="service-card-top">
                <div class="service-icon">
                  <i class="fas fa-prescription-bottle-medical"></i>
                </div>
                <h3 class="fw-bold h5">Digital Pharmacy</h3>
                <p class="small text-muted">
                  Order your required medicines safely with our integrated cart
                  ecosystem and fast door-step delivery options.
                </p>
              </div>
              <a href="/pharmacy" class="view-details-btn">
                Buy Medicine
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-4 col-md-6">
            <div
              class="service-card"
              onclick="window.location.href = '/findhospital'"
            >
              <div class="service-card-top">
                <div class="service-icon"><i class="fas fa-hospital"></i></div>
                <h3 class="fw-bold h5">Locate Hospitals</h3>
                <p class="small text-muted">
                  Map out the closest healthcare clinics and major medical
                  institutions around your immediate coordinates.
                </p>
              </div>
              <a href="/findhospital" class="view-details-btn">
                Search Map
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-4 col-md-6">
            <div
              class="service-card"
              onclick="window.location.href = '/Appointment'"
            >
              <div class="service-card-top">
                <div class="service-icon">
                  <i class="fas fa-calendar-check"></i>
                </div>
                <h3 class="fw-bold h5">Book Slot</h3>
                <p class="small text-muted">
                  Schedule appointments seamlessly by choosing your custom time
                  slot for physical or remote video calls.
                </p>
              </div>
              <a href="/Appointment" class="view-details-btn">
                Book Slot
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-4 col-md-6">
            <div
              class="service-card"
              onclick="window.location.href = '/Emergency'"
            >
              <div class="service-card-top">
                <div class="service-icon">
                  <i class="fas fa-truck-medical"></i>
                </div>
                <h3 class="fw-bold h5">Emergency Unit</h3>
                <p class="small text-muted">
                  Get immediate access to critical care assistance, emergency
                  alerts, and 24/7 technical help support.
                </p>
              </div>
              <a href="/Emergency" class="view-details-btn">
                Get Support
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>

          <div class="col-lg-4 col-md-6">
            <div
              class="service-card"
              onclick="window.location.href = '/profile'"
            >
              <div class="service-card-top">
                <div class="service-icon"><i class="fas fa-id-card"></i></div>
                <h3 class="fw-bold h5">Client Profile Zone</h3>
                <p class="small text-muted">
                  Safely maintain your active profile status, current
                  prescription sheets, and tracking logs database.
                </p>
              </div>
              <a href="/profile" class="view-details-btn">
                View Profile
                <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%- include('includes/footer') %>
  </body>
</html>
