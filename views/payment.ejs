<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="/styles/payment.css" rel="stylesheet" />
    <script src="/js/payment.js" defer></script>
  </head>
  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Gateway Verification</div>
          <h1 class="hero-title text-white">
            Secure Payment <br />
            & Transaction <br />
            Processing Node
          </h1>
          <p class="hero-text">
            Complete your order processing seamlessly. Your financial
            transactional data streams are filtered through standard high-grade
            encryption layers to guarantee maximum patient security.
          </p>
        </div>
      </div>
    </section>

    <section class="payment-wrapper-section py-5">
      <div
        class="container bg-white shadow-sm border rounded-5 p-4 p-lg-5"
        style="
          margin-top: -40px;
          position: relative;
          z-index: 10;
          max-width: 650px;
        "
      >
        <div class="payment-card-container text-center">
          <div class="about-badge mb-3">
            <span class="dot-teal me-2"></span> Secure Settlement
          </div>
          <h2 class="form-main-title mb-2">Payment Page</h2>
          <p class="text-muted small mb-4">
            Please complete your payment to proceed.
          </p>

          <div
            class="payment-icon-shield-box mb-5 d-flex justify-content-center"
          >
            <div
              class="shield-circle shadow-sm border rounded-circle d-flex align-items-center justify-content-center text-info bg-light-teal"
            >
              <i class="fas fa-shield-heart"></i>
            </div>
          </div>

          <div class="p-3 rounded-4 bg-light border mb-4 text-start">
            <h6 class="fw-bold text-dark mb-2">
              <i class="fas fa-receipt text-info me-2"></i> Checkout Bill
              Summary
            </h6>
            <div
              class="d-flex justify-content-between mb-1 text-secondary small"
            >
              <span>Payable Total Amount:</span>
              <span class="text-dark fw-bold" id="checkout-total-amt"
                >₹0.00</span
              >
            </div>
          </div>

          <div
            class="payment-action-group-panel d-flex justify-content-center align-items-center flex-wrap gap-3"
          >
            <button
              id="complete-payment-btn"
              class="btn-theme-action btn-pay-solid btn-pay-action"
            >
              <i class="fas fa-credit-card me-2"></i> Make Payment
            </button>
            <a href="/pharmacy" class="btn-theme-action btn-redirect-outline">
              Back to Shopping
            </a>
          </div>

          <div class="mt-4 pt-3 border-top text-center">
            <p
              class="text-muted mb-0 style-secure-tag-line"
              style="font-size: 12px; letter-spacing: 0.5px"
            ></p>
          </div>
        </div>
      </div>
    </section>

    <%- include('includes/footer') %>
  </body>
</html>
