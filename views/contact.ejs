<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head') %>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="styles/contact.css" rel="stylesheet" />
  </head>

  <body>
    <%- include('includes/header') %>

    <section class="hero-container-box">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">Get In Touch</div>
          <h1 class="hero-title text-white">
            We Are Here <br />
            To Assist Your <br />
            Medical Needs
          </h1>
          <p class="hero-text">
            Have questions about doctor availability, medicine orders, or
            hospital mappings? Drop us a message below, and our support
            infrastructure will get back to you immediately.
          </p>
        </div>
      </div>
    </section>

    <section class="contact-form-section py-5">
      <div
        class="container bg-white shadow-sm border rounded-5 p-4 p-lg-5"
        style="margin-top: -30px; position: relative; z-index: 10"
      >
        <div class="row align-items-center g-5">
          <div class="col-lg-6 d-none d-lg-block">
            <div class="about-image-wrapper">
              <img
                src="images/contact.jpg"
                alt="Contact Us"
                class="img-fluid rounded-4 shadow-sm"
                style="max-height: 520px; width: 100%; object-fit: cover"
              />
            </div>
          </div>
          <div class="col-lg-6">
            <div class="form-container">
              <div class="about-badge mb-3">
                <span class="dot-teal me-2"></span> Message Channel
              </div>
              <h2 class="form-main-title mb-4">Contact Us</h2>

              <form
                action="/"
                method="POST"
                class="contact-form d-flex flex-column gap-3"
              >
                <div class="form-group-custom position-relative">
                  <label for="name" class="form-label-text">Full Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    class="form-input-control"
                    placeholder="Enter your name"
                    required
                  />
                </div>
                <div class="form-group-custom position-relative">
                  <label for="email" class="form-label-text"
                    >Email Address</label
                  >
                  <input
                    type="email"
                    id="email"
                    name="email"
                    class="form-input-control"
                    placeholder="Enter your email"
                    required
                  />
                </div>
                <div class="form-group-custom position-relative">
                  <label for="phone" class="form-label-text"
                    >Phone Number</label
                  >
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="form-input-control"
                    placeholder="Enter your phone number"
                  />
                </div>
                <div class="form-group-custom position-relative">
                  <label for="inquiry" class="form-label-text"
                    >Type of Inquiry</label
                  >
                  <select
                    id="inquiry"
                    name="inquiry"
                    class="form-input-control select-arrow-pad"
                  >
                    <option value="general">General Inquiry</option>
                    <option value="support">Support</option>
                    <option value="feedback">Feedback</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="form-group-custom position-relative">
                  <label for="message" class="form-label-text"
                    >Your Message</label
                  >
                  <textarea
                    id="message"
                    name="message"
                    rows="4"
                    class="form-input-control text-area-pad"
                    placeholder="Write your message here..."
                    required
                  ></textarea>
                </div>
                <div class="form-group-custom mt-3">
                  <button type="submit" class="btn-submit-action">
                    Send Message
                    <i class="fas fa-arrow-right-long ms-2 rotate-arrow"></i>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section py-5">
      <div class="container text-center">
        <div class="services-badge mb-3">
          <span class="dot-teal me-2"></span> FAQ
        </div>
        <h2 class="services-main-title mb-5">
          Commonly asked questions about <br />
          our medical services
        </h2>

        <div class="faq-card-wrapper shadow-sm border">
          <div class="faq-scroll-area">
            <div class="faq-item">
              <h6 class="faq-question">Q1: How can I find nearby hospitals?</h6>
              <p class="faq-answer">
                A: You can use our search feature by entering your location to
                find hospitals near you.
              </p>
            </div>

            <div class="faq-item">
              <h6 class="faq-question">
                Q2: How do I book an appointment with a doctor?
              </h6>
              <p class="faq-answer">
                A: You can book an appointment by visiting the doctor’s profile
                and selecting the available time slots.
              </p>
            </div>

            <div class="faq-item">
              <h6 class="faq-question">
                Q3: What are the hospital services offered?
              </h6>
              <p class="faq-answer">
                A: Our hospitals provide various services including emergency
                care, surgeries, diagnostic testing, and more.
              </p>
            </div>

            <div class="faq-item">
              <h6 class="faq-question">Q4: Can I consult a doctor online?</h6>
              <p class="faq-answer">
                A: Yes, we offer online consultations. Simply choose the "Online
                Consultation" option when booking an appointment.
              </p>
            </div>

            <div class="faq-item">
              <h6 class="faq-question">Q5: Do you accept insurance?</h6>
              <p class="faq-answer">
                A: Yes, we accept a variety of health insurance providers.
                Please check our website for a list of accepted insurance
                companies.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="map-section py-5">
      <div class="container text-center">
        <div class="about-badge mb-3">
          <span class="dot-teal me-2"></span> Physical Office
        </div>
        <h2 class="services-main-title mb-5">Our Location</h2>
        <div class="map-frame-wrapper shadow border rounded-5 overflow-hidden">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3437.174971799975!2d76.65720287457472!3d30.516091096072213!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390fc32344a6e2d7%3A0x81b346dee91799ca!2sChitkara%20University!5e0!3m2!1sen!2sin!4v1735133048182!5m2!1sen!2sin"
            width="100%"
            height="450"
            style="border: 0; display: block"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>

    <%- include('includes/footer') %>
  </body>
  <script src="js/home1.js"></script>
</html>
